{
  "mcpServers": {
    "jevmem": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "jevmem",
        "jevmem-mcp"
      ]
    },
    "rtcw": {
      "type": "stdio",
      "command": "tools/rtcw-mcp/.venv/bin/python",
      "args": [
        "tools/rtcw-mcp/server.py"
      ]
    }
  }
}
