diff --git a/SP/code/game/bg_cod.c b/SP/code/game/bg_cod.c
new file mode 100644
index 00000000..15eda188
--- /dev/null
+++ b/SP/code/game/bg_cod.c
@@ -0,0 +1,114 @@
+// codmod: new file (phase 2.0) -- bg_cod.c
+//
+// Defines the cod_* tuning cvar table and the codTuning_t instance that bg_pmove.c (and
+// qagame/cgame modules) read every frame. See bg_cod.h and docs/architecture.md section 5.
+
+#include "../qcommon/q_shared.h"
+#include "bg_public.h"
+#include "bg_cod.h"
+
+// codmod: forward-declared the same way bg_pmove.c declares cg_gameType/g_gametype --
+// this file is compiled once into qagame (-DGAMEDLL) and once into cgame (-DCGAMEDLL),
+// and both modules already have these traps with an identical signature.
+void trap_Cvar_Register( vmCvar_t *cvar, const char *var_name, const char *value, int flags );
+void trap_Cvar_Update( vmCvar_t *cvar );
+
+// codmod: zero-initialized; real values come from BG_CodUpdateCvars() before first use.
+codTuning_t bg_cod;
+
+#define CODOFS( x ) ( (size_t)&( ( (codTuning_t *)0 )->x ) )
+
+// codmod: Phase 2 cvars (docs/reference-values.md + docs/phase-2-movement.md). Flags are 0
+// for tunables (not archived, so code defaults always apply -- user overrides live in
+// mod/codmod/codmod.cfg) except cod_debugHud, which is a user preference.
+const codCvarDef_t bg_codCvars[] = {
+	{ "cod_enable",             "0",    0,            CODOFS( enable ),             1 },
+	{ "cod_moveEnable",         "1",    0,            CODOFS( moveEnable ),         1 },
+	{ "cod_leanEnable",         "1",    0,            CODOFS( leanEnable ),         1 },
+
+	{ "cod_runSpeed",           "200",  0,            CODOFS( runSpeed ),           0 },
+	{ "cod_sprintScale",        "1.5",  0,            CODOFS( sprintScale ),        0 },
+	{ "cod_walkScale",          "0.45", 0,            CODOFS( walkScale ),          0 },
+	{ "cod_crouchScale",        "0.65", 0,            CODOFS( crouchScale ),        0 },
+	{ "cod_backScale",          "0.7",  0,            CODOFS( backScale ),          0 },
+	{ "cod_strafeScale",        "0.85", 0,            CODOFS( strafeScale ),        0 },
+
+	{ "cod_sprintTime",         "4",    0,            CODOFS( sprintTime ),         0 },
+	{ "cod_sprintRechargeTime", "5",    0,            CODOFS( sprintRechargeTime ), 0 },
+	{ "cod_sprintMinTime",      "1",    0,            CODOFS( sprintMinTime ),      0 },
+	{ "cod_sprintForwardOnly",  "1",    0,            CODOFS( sprintForwardOnly ),  1 },
+	{ "cod_sprintJumpCost",     "2000", 0,            CODOFS( sprintJumpCost ),     0 },
+
+	{ "cod_duckTime",           "70",   0,            CODOFS( duckTime ),           0 },
+	{ "cod_duckEase",           "1",    0,            CODOFS( duckEase ),           1 },
+	{ "cod_duckGunDip",         "1",    0,            CODOFS( duckGunDip ),         1 },
+
+	{ "cod_leanMax",            "32",   0,            CODOFS( leanMax ),            0 },
+	{ "cod_leanRollScale",      "0.6",  0,            CODOFS( leanRollScale ),      0 },
+	{ "cod_leanTimeIn",         "200",  0,            CODOFS( leanTimeIn ),         0 },
+	{ "cod_leanTimeOut",        "180",  0,            CODOFS( leanTimeOut ),        0 },
+	{ "cod_leanAllowFire",      "1",    0,            CODOFS( leanAllowFire ),      1 },
+	{ "cod_leanEase",           "1",    0,            CODOFS( leanEase ),           1 },
+
+	{ "cod_aiSpeedMode",        "1",    0,            CODOFS( aiSpeedMode ),        1 },
+	{ "cod_aiSpeedScale",       "1",    0,            CODOFS( aiSpeedScale ),       0 },
+
+	{ "cod_debugHud",           "0",    CVAR_ARCHIVE, CODOFS( debugHud ),           1 },
+};
+
+const int bg_numCodCvars = sizeof( bg_codCvars ) / sizeof( bg_codCvars[0] );
+
+/*
+================
+BG_CodRegisterCvars
+
+codmod: registers every entry of bg_codCvars into the caller's vmCvar_t array (one slot
+per entry, in order), then applies the just-registered values into bg_cod.
+================
+*/
+void BG_CodRegisterCvars( vmCvar_t *cvars, int maxCvars ) {
+	int i;
+	int n;
+
+	n = bg_numCodCvars;
+	if ( n > maxCvars ) {
+		n = maxCvars;    // codmod: should never happen -- bump BG_COD_MAX_CVARS if it does
+	}
+
+	for ( i = 0; i < n; i++ ) {
+		trap_Cvar_Register( &cvars[i], bg_codCvars[i].name, bg_codCvars[i].def, bg_codCvars[i].flags );
+	}
+
+	BG_CodUpdateCvars( cvars, n );
+}
+
+/*
+================
+BG_CodUpdateCvars
+
+codmod: pulls current cvar values into bg_cod. Called every frame from G_UpdateCvars /
+CG_UpdateCvars so cvar changes (and savegame loads, see architecture.md section 7) take
+effect immediately.
+================
+*/
+void BG_CodUpdateCvars( vmCvar_t *cvars, int maxCvars ) {
+	int i;
+	int n;
+	byte *dst;
+
+	n = bg_numCodCvars;
+	if ( n > maxCvars ) {
+		n = maxCvars;
+	}
+
+	for ( i = 0; i < n; i++ ) {
+		trap_Cvar_Update( &cvars[i] );
+
+		dst = (byte *)&bg_cod + bg_codCvars[i].ofs;
+		if ( bg_codCvars[i].isInt ) {
+			*(int *)dst = cvars[i].integer;
+		} else {
+			*(float *)dst = cvars[i].value;
+		}
+	}
+}
diff --git a/SP/code/game/bg_cod.h b/SP/code/game/bg_cod.h
new file mode 100644
index 00000000..2e225040
--- /dev/null
+++ b/SP/code/game/bg_cod.h
@@ -0,0 +1,73 @@
+// codmod: new file (phase 2.0) -- bg_cod.h
+//
+// Shared CoD4-style tuning table for the player. Compiled into *both* qagame and cgame
+// (see bg_pmove.o entries in SP/Makefile) -- each module gets its own copy of bg_cod,
+// kept in sync every frame because g_main.c and cg_main.c both read the same cvars.
+//
+// See docs/architecture.md section 5 (outer repo) for the design rationale.
+
+#ifndef __BG_COD_H__
+#define __BG_COD_H__
+
+#include "../qcommon/q_shared.h"
+
+// codmod: all CoD-style tuning in one struct, filled in by BG_CodUpdateCvars() every frame.
+// Never add playerState_t fields for this -- see the golden rules in architecture.md.
+typedef struct {
+	int enable;             // master switch: 0 = vanilla behaviour everywhere
+	int moveEnable;         // speed/sprint/walk changes (2.1)
+	int leanEnable;         // lean changes (2.3)
+
+	float runSpeed;         // u/s, player jog
+	float sprintScale;      // x runSpeed
+	float walkScale;        // x runSpeed when BUTTON_WALKING
+	float crouchScale;      // x runSpeed
+	float backScale;        // x runSpeed when moving backward
+	float strafeScale;      // x runSpeed when strafing
+
+	float sprintTime;           // seconds, full stamina bar drain time while sprinting+moving
+	float sprintRechargeTime;   // seconds, empty -> full recharge time
+	float sprintMinTime;        // seconds of stamina required to *start* a new sprint
+	int sprintForwardOnly;      // qboolean-ish: sprint requires cmd.forwardmove > 0
+	float sprintJumpCost;       // stamina units taken on jump (vanilla default 2000)
+
+	float duckTime;    // ms, cgame duck viewheight smoothing
+	int duckEase;       // ease-out curve instead of linear
+	int duckGunDip;     // small viewmodel dip following the same curve
+
+	float leanMax;         // u, lean offset
+	float leanRollScale;   // camera roll = leanf * leanRollScale
+	float leanTimeIn;      // ms, time to reach full lean
+	float leanTimeOut;     // ms, time to return to center
+	int leanAllowFire;     // allow firing (and crosshair) while leaned
+	int leanEase;          // smoothstep the displayed lean fraction (cgame-only)
+
+	int aiSpeedMode;     // 0 = vanilla, 1 = match player speeds, 2 = scale anim-derived speeds
+	float aiSpeedScale;  // multiplier used by aiSpeedMode 2
+
+	int debugHud;    // 0 off, 1 HUD, 2 HUD + nearest AI speed
+} codTuning_t;
+
+// codmod: one instance per module (qagame and cgame each link their own bg_cod.o).
+extern codTuning_t bg_cod;
+
+// codmod: single source of truth for cvar name/default/flags and where it lands in bg_cod.
+typedef struct {
+	const char *name;
+	const char *def;
+	int flags;
+	size_t ofs;      // offset into codTuning_t, see CODOFS() in bg_cod.c
+	int isInt;       // qtrue: read cvar.integer, qfalse: read cvar.value
+} codCvarDef_t;
+
+extern const codCvarDef_t bg_codCvars[];
+extern const int bg_numCodCvars;
+
+// codmod: g_main.c / cg_main.c each keep a static vmCvar_t[BG_COD_MAX_CVARS] and pass it in.
+// Bump this if bg_codCvars ever grows past it -- BG_CodRegisterCvars() clamps defensively.
+#define BG_COD_MAX_CVARS 32
+
+void BG_CodRegisterCvars( vmCvar_t *cvars, int maxCvars );
+void BG_CodUpdateCvars( vmCvar_t *cvars, int maxCvars );
+
+#endif // __BG_COD_H__
