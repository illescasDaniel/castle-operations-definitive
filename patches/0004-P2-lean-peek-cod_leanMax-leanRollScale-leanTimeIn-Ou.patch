From 9944701b6b1c0bd005f6917e4c6f00b80640477a Mon Sep 17 00:00:00 2001
From: Daniel Illescas Romero <illescas.daniel@protonmail.com>
Date: Thu, 8 Oct 2026 17:15:08 +0200
Subject: [PATCH 04/64] P2: lean / peek -
 cod_leanMax/leanRollScale/leanTimeIn/Out/leanAllowFire/leanEase (2.3)

- game/bg_pmove.c PM_UpdateLean: use bg_cod.leanMax/leanTimeIn/leanTimeOut when
  cod_leanEnable (reads bg_cod only, not pm, since this also runs from
  PM_UpdateViewAngles with pm == NULL). Still returns early for AI. Don't zero
  leaning on EF_FIRING when cod_leanAllowFire.
- game/bg_pmove.c PM_Weapon: skip the "leaning - no fire" return for the
  player when cod_leanAllowFire (g_weapon.c's muzzle leanf offset already
  applies unconditionally, verified, no change needed there).
- cgame/cg_draw.c CG_DrawCrosshair/CG_DrawCrosshair3D: keep showing the
  crosshair while leaning when cod_leanAllowFire.
- cgame/cg_weapons.c CG_CalculateWeaponPosition: counter-roll scaled by
  cod_leanRollScale instead of the fixed 1/2 so the gun stays level under the
  new tilt; skip the "pitch gun down, firing not allowed" line when
  cod_leanAllowFire.
- cgame/cg_view.c CG_OffsetFirstPersonView: camera roll = leanf *
  cod_leanRollScale (instead of leanf/2); with cod_leanEase, smoothstep the
  displayed lean fraction for both roll and offset so peeking accelerates and
  settles. cgame-only, so prediction is unaffected.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 SP/code/cgame/cg_draw.c    | 14 +++++++++----
 SP/code/cgame/cg_view.c    | 28 +++++++++++++++++++++++---
 SP/code/cgame/cg_weapons.c | 18 +++++++++++++----
 SP/code/game/bg_pmove.c    | 41 ++++++++++++++++++++++++++------------
 4 files changed, 77 insertions(+), 24 deletions(-)

diff --git a/SP/code/cgame/cg_draw.c b/SP/code/cgame/cg_draw.c
index 1fd47b4f..af255d0e 100644
--- a/SP/code/cgame/cg_draw.c
+++ b/SP/code/cgame/cg_draw.c
@@ -2352,11 +2352,14 @@ static void CG_DrawCrosshair( void ) {
 	int weapnum;                // DHM - Nerve
 	vec4_t hcolor = {1, 1, 1, 1};
 	qboolean friendInSights = qfalse;
+	qboolean codLeanFire;    // codmod: cod_leanAllowFire keeps the crosshair up while leaning (2.3.2)
 
 	if ( cg.renderingThirdPerson ) {
 		return;
 	}
 
+	codLeanFire = ( bg_cod.enable && bg_cod.leanEnable && bg_cod.leanAllowFire ) ? qtrue : qfalse;
+
 	hcolor[3] = cg_crosshairAlpha.value;    //----(SA)	added
 
 	if ( cg_fixedAspect.integer ) {
@@ -2412,7 +2415,7 @@ static void CG_DrawCrosshair( void ) {
 		}
 
 		if ( !friendInSights ) {
-			if ( !cg.snap->ps.leanf ) {     // no crosshair while leaning
+			if ( !cg.snap->ps.leanf || codLeanFire ) {     // no crosshair while leaning
 				CG_FillRect( 319, 239, 2, 2, hcolor );      // dot
 			}
 			return;
@@ -2463,7 +2466,7 @@ static void CG_DrawCrosshair( void ) {
 	}
 
 	// no crosshair while leaning
-	if ( cg.snap->ps.leanf ) {
+	if ( cg.snap->ps.leanf && !codLeanFire ) {
 		return;
 	}
 
@@ -2532,6 +2535,7 @@ static void CG_DrawCrosshair3D( void ) {
 	int weapnum;                // DHM - Nerve
 	vec4_t hcolor = {1, 1, 1, 1};
 	qboolean friendInSights = qfalse;
+	qboolean codLeanFire;    // codmod: cod_leanAllowFire keeps the crosshair up while leaning (2.3.2)
 
 	trace_t trace;
 	vec3_t endpos;
@@ -2543,6 +2547,8 @@ static void CG_DrawCrosshair3D( void ) {
 		return;
 	}
 
+	codLeanFire = ( bg_cod.enable && bg_cod.leanEnable && bg_cod.leanAllowFire ) ? qtrue : qfalse;
+
 	hcolor[3] = cg_crosshairAlpha.value;    //----(SA)	added
 
 
@@ -2595,7 +2601,7 @@ static void CG_DrawCrosshair3D( void ) {
 		}
 
 		if ( !friendInSights ) {
-			if ( !cg.snap->ps.leanf ) {     // no crosshair while leaning
+			if ( !cg.snap->ps.leanf || codLeanFire ) {     // no crosshair while leaning
 				CG_FillRect( 319, 239, 2, 2, hcolor );      // dot
 			}
 			return;
@@ -2647,7 +2653,7 @@ static void CG_DrawCrosshair3D( void ) {
 	}
 
 	// no crosshair while leaning
-	if ( cg.snap->ps.leanf ) {
+	if ( cg.snap->ps.leanf && !codLeanFire ) {
 		return;
 	}
 
diff --git a/SP/code/cgame/cg_view.c b/SP/code/cgame/cg_view.c
index b0dd2df3..634bdc00 100644
--- a/SP/code/cgame/cg_view.c
+++ b/SP/code/cgame/cg_view.c
@@ -689,9 +689,31 @@ static void CG_OffsetFirstPersonView( void ) {
 	if ( cg.predictedPlayerState.leanf != 0 ) {
 		//add leaning offset
 		vec3_t right;
-		cg.refdefViewAngles[2] += cg.predictedPlayerState.leanf / 2.0f;
-		AngleVectors( cg.refdefViewAngles, NULL, right, NULL );
-		VectorMA( cg.refdef.vieworg, cg.predictedPlayerState.leanf, right, cg.refdef.vieworg );
+
+		// codmod: cod_leanRollScale camera tilt, with optional smoothstep ease on the
+		// *displayed* fraction so peeking accelerates and settles (phase 2.3.3). cgame-only,
+		// so it can't affect prediction.
+		if ( bg_cod.enable && bg_cod.leanEnable ) {
+			float leanf = cg.predictedPlayerState.leanf;
+			float leanMax = ( bg_cod.leanMax > 0 ) ? bg_cod.leanMax : 1.0f;
+
+			if ( bg_cod.leanEase ) {
+				float s = fabs( leanf ) / leanMax;
+				if ( s > 1.0f ) {
+					s = 1.0f;
+				}
+				s = s * s * ( 3.0f - 2.0f * s );   // smoothstep
+				leanf = ( leanf < 0 ) ? -leanMax * s : leanMax * s;
+			}
+
+			cg.refdefViewAngles[2] += leanf * bg_cod.leanRollScale;
+			AngleVectors( cg.refdefViewAngles, NULL, right, NULL );
+			VectorMA( cg.refdef.vieworg, leanf, right, cg.refdef.vieworg );
+		} else {
+			cg.refdefViewAngles[2] += cg.predictedPlayerState.leanf / 2.0f;
+			AngleVectors( cg.refdefViewAngles, NULL, right, NULL );
+			VectorMA( cg.refdef.vieworg, cg.predictedPlayerState.leanf, right, cg.refdef.vieworg );
+		}
 	}
 
 	// pivot the eye based on a neck length
diff --git a/SP/code/cgame/cg_weapons.c b/SP/code/cgame/cg_weapons.c
index 7bdc9947..e962d798 100644
--- a/SP/code/cgame/cg_weapons.c
+++ b/SP/code/cgame/cg_weapons.c
@@ -1720,6 +1720,12 @@ static void CG_CalculateWeaponPosition( vec3_t origin, vec3_t angles ) {
 	// adjust 'lean' into weapon
 	if ( cg.predictedPlayerState.leanf != 0 ) {
 		vec3_t right, up;
+		qboolean codLean;
+		float rollScale;
+
+		// codmod: cod_leanAllowFire/leanRollScale (phase 2.3.2/2.3.4)
+		codLean = ( bg_cod.enable && bg_cod.leanEnable ) ? qtrue : qfalse;
+		rollScale = codLean ? bg_cod.leanRollScale : 0.5f;    // vanilla roll was leanf/2
 
 		leanscale = 1.0f;
 
@@ -1747,13 +1753,17 @@ static void CG_CalculateWeaponPosition( vec3_t origin, vec3_t angles ) {
 			break;
 		}
 
-		// reverse the roll on the weapon so it stays relatively level
-		angles[ROLL] -= cg.predictedPlayerState.leanf / ( leanscale * 2.0f );
+		// reverse the roll on the weapon so it stays relatively level, scaled to match
+		// cod_leanRollScale so the gun doesn't out-tilt (or under-tilt) the camera (2.3.4)
+		angles[ROLL] -= cg.predictedPlayerState.leanf * rollScale / leanscale;
 		AngleVectors( angles, NULL, right, up );
 		VectorMA( origin, angles[ROLL], right, origin );
 
-		// pitch the gun down a bit to show that firing is not allowed when leaning
-		angles[PITCH] += ( fabs( cg.predictedPlayerState.leanf ) / 2.0f );
+		// pitch the gun down a bit to show that firing is not allowed when leaning --
+		// codmod: skip this when cod_leanAllowFire, firing is allowed (phase 2.3.2)
+		if ( !( codLean && bg_cod.leanAllowFire ) ) {
+			angles[PITCH] += ( fabs( cg.predictedPlayerState.leanf ) / 2.0f );
+		}
 
 		// this gives you some impression that the weapon stays in relatively the same
 		// position while you lean, so you appear to 'peek' over the weapon
diff --git a/SP/code/game/bg_pmove.c b/SP/code/game/bg_pmove.c
index 44faf1c7..88d118bf 100644
--- a/SP/code/game/bg_pmove.c
+++ b/SP/code/game/bg_pmove.c
@@ -3126,7 +3126,9 @@ static void PM_Weapon( void ) {
 	}
 
 	// player is leaning - no fire
-	if ( pm->ps->leanf != 0 && pm->ps->weapon != WP_GRENADE_LAUNCHER && pm->ps->weapon != WP_GRENADE_PINEAPPLE && pm->ps->weapon != WP_DYNAMITE ) {
+	// codmod: cod_leanAllowFire lets the player (not AI) fire while leaned (phase 2.3.2)
+	if ( pm->ps->leanf != 0 && pm->ps->weapon != WP_GRENADE_LAUNCHER && pm->ps->weapon != WP_GRENADE_PINEAPPLE && pm->ps->weapon != WP_DYNAMITE
+		 && !( !pm->ps->aiChar && bg_cod.enable && bg_cod.leanEnable && bg_cod.leanAllowFire ) ) {
 		return;
 	}
 
@@ -3655,11 +3657,21 @@ void PM_UpdateLean( playerState_t *ps, usercmd_t *cmd, pmove_t *tpm ) {
 	float leanofs = 0;
 	vec3_t viewangles;
 	trace_t trace;
+	qboolean codLean;
+	float leanMax, leanTimeTo, leanTimeFr;
 
 	if ( ps->aiChar ) {
 		return;
 	}
 
+	// codmod: cod_leanMax/leanTimeIn/leanTimeOut when enabled (phase 2.3.1). Reads only
+	// bg_cod, not pm, because this also runs from PM_UpdateViewAngles with pm == NULL
+	// (the tpm path below).
+	codLean = ( bg_cod.enable && bg_cod.leanEnable ) ? qtrue : qfalse;
+	leanMax    = codLean ? bg_cod.leanMax    : LEAN_MAX;
+	leanTimeTo = codLean ? bg_cod.leanTimeIn  : LEAN_TIME_TO;
+	leanTimeFr = codLean ? bg_cod.leanTimeOut : LEAN_TIME_FR;
+
 	if ( ( cmd->wbuttons & ( WBUTTON_LEANLEFT | WBUTTON_LEANRIGHT ) )  && !cmd->forwardmove && cmd->upmove <= 0 ) {
 		// if both are pressed, result is no lean
 		if ( cmd->wbuttons & WBUTTON_LEANLEFT ) {
@@ -3672,8 +3684,11 @@ void PM_UpdateLean( playerState_t *ps, usercmd_t *cmd, pmove_t *tpm ) {
 
 	// not allowed when...
 	if ( ( ps->eFlags & ( EF_MELEE_ACTIVE |   // ...holding a chair
-						  EF_MG42_ACTIVE  | // ...on mg42
-						  EF_FIRING ) ) ) { // ...firing
+						  EF_MG42_ACTIVE ) ) ) { // ...on mg42
+		leaning = 0;
+	}
+	// codmod: cod_leanAllowFire lets the player keep leaning while firing (phase 2.3.2)
+	if ( ( ps->eFlags & EF_FIRING ) && !( codLean && bg_cod.leanAllowFire ) ) { // ...firing
 		leaning = 0;
 	}
 
@@ -3682,13 +3697,13 @@ void PM_UpdateLean( playerState_t *ps, usercmd_t *cmd, pmove_t *tpm ) {
 	if ( !leaning ) {  // go back to center position
 		if ( leanofs > 0 ) {        // right
 			//FIXME: play lean anim backwards?
-			leanofs -= ( ( (float)pml.msec / LEAN_TIME_FR ) * LEAN_MAX );
+			leanofs -= ( ( (float)pml.msec / leanTimeFr ) * leanMax );
 			if ( leanofs < 0 ) {
 				leanofs = 0;
 			}
 		} else if ( leanofs < 0 )   { // left
 			//FIXME: play lean anim backwards?
-			leanofs += ( ( (float)pml.msec / LEAN_TIME_FR ) * LEAN_MAX );
+			leanofs += ( ( (float)pml.msec / leanTimeFr ) * leanMax );
 			if ( leanofs > 0 ) {
 				leanofs = 0;
 			}
@@ -3697,21 +3712,21 @@ void PM_UpdateLean( playerState_t *ps, usercmd_t *cmd, pmove_t *tpm ) {
 
 	if ( leaning ) {
 		if ( leaning > 0 ) {   // right
-			if ( leanofs < LEAN_MAX ) {
-				leanofs += ( ( (float)pml.msec / LEAN_TIME_TO ) * LEAN_MAX );
+			if ( leanofs < leanMax ) {
+				leanofs += ( ( (float)pml.msec / leanTimeTo ) * leanMax );
 			}
 
-			if ( leanofs > LEAN_MAX ) {
-				leanofs = LEAN_MAX;
+			if ( leanofs > leanMax ) {
+				leanofs = leanMax;
 			}
 
 		} else {              // left
-			if ( leanofs > -LEAN_MAX ) {
-				leanofs -= ( ( (float)pml.msec / LEAN_TIME_TO ) * LEAN_MAX );
+			if ( leanofs > -leanMax ) {
+				leanofs -= ( ( (float)pml.msec / leanTimeTo ) * leanMax );
 			}
 
-			if ( leanofs < -LEAN_MAX ) {
-				leanofs = -LEAN_MAX;
+			if ( leanofs < -leanMax ) {
+				leanofs = -leanMax;
 			}
 
 		}
