 void AICast_QueryThink( cast_state_t *cs );
 void AICast_DeadClipWalls( cast_state_t *cs );
 void AICast_IdleReload( cast_state_t *cs );
+void AICast_CodApplySpeedMode( cast_state_t *cs, int aiCharacter );   // codmod: phase 2.4
 //
 // ai_cast_script.c
 qboolean AICast_ScriptRun( cast_state_t *cs, qboolean force );
diff --git a/SP/code/game/ai_cast_characters.c b/SP/code/game/ai_cast_characters.c
index 71c58229..a002e2ac 100644
--- a/SP/code/game/ai_cast_characters.c
+++ b/SP/code/game/ai_cast_characters.c
@@ -1460,6 +1460,10 @@ void AIChar_spawn( gentity_t *ent ) {
 	cs->castScriptStatus.castScriptEventIndex = -1;
 	cs->castScriptStatus.scriptAttackEnt = -1;
 	//
+	// codmod: cod_aiSpeedMode -- apply at spawn time too, so AI never run a frame of their
+	// un-matched starting speeds before AICast_Think's first update (phase 2.4)
+	AICast_CodApplySpeedMode( cs, ent->aiCharacter );
+	//
 	// set crouch move speed
 	ent->client->ps.crouchSpeedScale = cs->attributes[CROUCHING_SPEED] / cs->attributes[RUNNING_SPEED];
 	//
