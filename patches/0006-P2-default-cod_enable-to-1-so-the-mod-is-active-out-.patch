From 9573c722c9c0c8ea863bb45d680af39aba10e28c Mon Sep 17 00:00:00 2001
From: Daniel Illescas Romero <illescas.daniel@protonmail.com>
Date: Thu, 8 Oct 2026 17:19:25 +0200
Subject: [PATCH 06/64] P2: default cod_enable to 1 so the mod is active out of
 the box

cod_enable 0 remains the instant A/B back to vanilla.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 SP/code/game/bg_cod.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/SP/code/game/bg_cod.c b/SP/code/game/bg_cod.c
index 15eda188..0809c545 100644
--- a/SP/code/game/bg_cod.c
+++ b/SP/code/game/bg_cod.c
@@ -22,7 +22,7 @@ codTuning_t bg_cod;
 // for tunables (not archived, so code defaults always apply -- user overrides live in
 // mod/codmod/codmod.cfg) except cod_debugHud, which is a user preference.
 const codCvarDef_t bg_codCvars[] = {
-	{ "cod_enable",             "0",    0,            CODOFS( enable ),             1 },
+	{ "cod_enable",             "1",    0,            CODOFS( enable ),             1 },
 	{ "cod_moveEnable",         "1",    0,            CODOFS( moveEnable ),         1 },
 	{ "cod_leanEnable",         "1",    0,            CODOFS( leanEnable ),         1 },
 
