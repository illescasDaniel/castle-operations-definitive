From f2ecc03deb43da3cfb54c6835bcaa553d8454920 Mon Sep 17 00:00:00 2001
From: Daniel Illescas Romero <illescas.daniel@protonmail.com>
Date: Thu, 8 Oct 2026 19:15:33 +0200
Subject: [PATCH 20/65] P3: stop ADS gun floating mid-screen

Clamp sightDist to viewmodel range (5-12), default 8, and cap wild
tag deltas. Large sightDist was parking the arms in mid-view.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 SP/code/cgame/cg_cod.c | 21 +++++++++++++++++----
 SP/code/game/bg_cod.c  |  7 ++++---
 2 files changed, 21 insertions(+), 7 deletions(-)

diff --git a/SP/code/cgame/cg_cod.c b/SP/code/cgame/cg_cod.c
index d192929e..2338e71d 100644
--- a/SP/code/cgame/cg_cod.c
+++ b/SP/code/cgame/cg_cod.c
@@ -91,10 +91,13 @@ void CG_CodApplyIronSightAds( vec3_t handOrigin, vec3_t angles, int weaponNum, f
 	barrelBack  = bg_cod.adsBarrelBack  + ads->barrelBack;
 	sightDist   = bg_cod.adsSightDist   + ads->sightDist;
 
-	// codmod: keep the rear sight far enough ahead of the eye that we never clip into the
-	// mesh ("looking inside the gun"). Zoomed FOV makes close geometry feel even closer.
-	if ( sightDist < 14.0f ) {
-		sightDist = 14.0f;
+	// codmod: viewmodels sit a few units in front of the eye. A large sightDist parks the
+	// gun in the middle of the world view ("floating arms"). Keep it close like CoD.
+	if ( sightDist < 5.0f ) {
+		sightDist = 5.0f;
+	}
+	if ( sightDist > 12.0f ) {
+		sightDist = 12.0f;
 	}
 
 	fovScale = ( bg_cod.adsTune && weaponNum == cg.weaponSelect )
@@ -153,6 +156,16 @@ void CG_CodApplyIronSightAds( vec3_t handOrigin, vec3_t angles, int weaponNum, f
 			VectorMA( cg.refdef.vieworg, sightDist + fovComp, cg.refdef.viewaxis[0], desired );
 
 			VectorSubtract( desired, sightPos, delta );
+
+			// codmod: if tag resolution is wrong, delta can be huge and fling the gun into
+			// the middle of the scene. Cap the correction to a viewmodel-sized move.
+			{
+				float deltaLen = VectorLength( delta );
+				if ( deltaLen > 40.0f ) {
+					VectorScale( delta, 40.0f / deltaLen, delta );
+				}
+			}
+
 			VectorMA( handOrigin, e, delta, handOrigin );
 
 			// No bore-to-view rotation pass: the hand already inherits viewangles, and
diff --git a/SP/code/game/bg_cod.c b/SP/code/game/bg_cod.c
index 25ca0cd9..6ab999e5 100644
--- a/SP/code/game/bg_cod.c
+++ b/SP/code/game/bg_cod.c
@@ -68,10 +68,11 @@ const codCvarDef_t bg_codCvars[] = {
 	{ "cod_adsGunFovComp",      "2",    0,            CODOFS( adsGunFovComp ),      0 },
 	// codmod: CoD-style iron-sight auto-align defaults (cgame). Per-weapon table can override.
 	// sightHeight must clear the slide (too low = looking down the bore / "inside the gun").
-	// sightDist is eye relief (too small = near-clip into the rear of the weapon).
-	{ "cod_adsSightHeight",     "6",    0,            CODOFS( adsSightHeight ),     0 },
+	// sightDist is how far ahead of the eye the rear sight sits -- viewmodel scale, ~6-10.
+	// (A previous default of 18 made the gun look like floating arms in mid-screen.)
+	{ "cod_adsSightHeight",     "6.5",  0,            CODOFS( adsSightHeight ),     0 },
 	{ "cod_adsBarrelBack",      "10",   0,            CODOFS( adsBarrelBack ),      0 },
-	{ "cod_adsSightDist",       "18",   0,            CODOFS( adsSightDist ),       0 },
+	{ "cod_adsSightDist",       "8",    0,            CODOFS( adsSightDist ),       0 },
 	{ "cod_scopeSwitchTime",    "0",    0,            CODOFS( scopeSwitchTime ),    0 },
 
 	// codmod: Phase 3.5 alignment tooling -- see docs/phase-3-ads.md "Alignment tooling".
-- 
