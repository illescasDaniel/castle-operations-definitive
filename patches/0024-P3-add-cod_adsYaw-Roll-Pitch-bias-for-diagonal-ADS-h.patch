From 45054f232678ae62f5aeadb0cde35841bf701bec Mon Sep 17 00:00:00 2001
From: Daniel Illescas Romero <illescas.daniel@protonmail.com>
Date: Thu, 8 Oct 2026 19:41:39 +0200
Subject: [PATCH 24/64] P3: add cod_adsYaw/Roll/Pitch bias for diagonal ADS
 hold

RTCW hip-fire meshes can still look crooked after tag_flash align.
Default yaw -7 (~clockwise from above); tunable in console.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 SP/code/cgame/cg_cod.c | 9 +++++----
 SP/code/game/bg_cod.c  | 5 +++++
 SP/code/game/bg_cod.h  | 3 +++
 3 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/SP/code/cgame/cg_cod.c b/SP/code/cgame/cg_cod.c
index d7e3724c..f35caef4 100644
--- a/SP/code/cgame/cg_cod.c
+++ b/SP/code/cgame/cg_cod.c
@@ -227,13 +227,14 @@ void CG_CodApplyIronSightAds( vec3_t handOrigin, vec3_t angles, int weaponNum, f
 		angles[i] += AngleDelta( alignedAngles[i], angles[i] ) * e;
 	}
 
-	// Fine bias (table / live tune) -- small corrections after auto-align.
+	// Fine bias after auto-align: global cod_adsPitch/Yaw/Roll (mesh vs tag mismatch) plus
+	// per-weapon table / live tune. Yaw -7 ≈ clockwise ~7° from above (Luger default).
 	VectorMA( handOrigin, ads->fwd   * e, cg.refdef.viewaxis[0], handOrigin );
 	VectorMA( handOrigin, ads->right * e, cg.refdef.viewaxis[1], handOrigin );
 	VectorMA( handOrigin, ads->up    * e, cg.refdef.viewaxis[2], handOrigin );
-	angles[PITCH] += ads->pitch * e;
-	angles[YAW]   += ads->yaw   * e;
-	angles[ROLL]  += ads->roll  * e;
+	angles[PITCH] += ( bg_cod.adsPitch + ads->pitch ) * e;
+	angles[YAW]   += ( bg_cod.adsYaw   + ads->yaw )   * e;
+	angles[ROLL]  += ( bg_cod.adsRoll  + ads->roll )  * e;
 }
 
 /*
diff --git a/SP/code/game/bg_cod.c b/SP/code/game/bg_cod.c
index 03445b46..a38916c1 100644
--- a/SP/code/game/bg_cod.c
+++ b/SP/code/game/bg_cod.c
@@ -71,6 +71,11 @@ const codCvarDef_t bg_codCvars[] = {
 	{ "cod_adsSightHeight",     "4",    0,            CODOFS( adsSightHeight ),     0 },
 	{ "cod_adsBarrelBack",      "10",   0,            CODOFS( adsBarrelBack ),      0 },
 	{ "cod_adsSightDist",       "18",   0,            CODOFS( adsSightDist ),       0 },
+	// codmod: RTCW viewmodels are built for hip-fire; tag_flash "straight" can still look
+	// diagonally held. Global angle bias after auto-align (Luger: ~7° clockwise from above).
+	{ "cod_adsPitch",           "0",    0,            CODOFS( adsPitch ),           0 },
+	{ "cod_adsYaw",             "-7",   0,            CODOFS( adsYaw ),             0 },
+	{ "cod_adsRoll",            "0",    0,            CODOFS( adsRoll ),            0 },
 	{ "cod_scopeSwitchTime",    "0",    0,            CODOFS( scopeSwitchTime ),    0 },
 
 	// codmod: Phase 3.5 alignment tooling -- see docs/phase-3-ads.md "Alignment tooling".
diff --git a/SP/code/game/bg_cod.h b/SP/code/game/bg_cod.h
index d086cdbc..b7d62d9a 100644
--- a/SP/code/game/bg_cod.h
+++ b/SP/code/game/bg_cod.h
@@ -57,6 +57,9 @@ typedef struct {
 	float adsSightHeight;   // default u above tag_flash bore to the rear sight (cgame auto-align)
 	float adsBarrelBack;    // default u from tag_flash back to the rear sight along the bore
 	float adsSightDist;     // default u ahead of the camera for the rear sight when fully ADS
+	float adsPitch;         // degrees, global ADS angle bias after auto-align (cgame)
+	float adsYaw;           // degrees, global ADS angle bias (neg = clockwise from above)
+	float adsRoll;          // degrees, global ADS angle bias (pos ≈ clockwise looking forward)
 	float scopeSwitchTime;  // ms, rifle<->scope weapon-change time when >0 (phase 3.8); 0 = vanilla 250ms
 
 	int adsLock;      // debug: cgame treats ADS as fully in, visual only (alignment tooling)
-- 
