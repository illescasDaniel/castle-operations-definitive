From 0064aa38f1a0756fc61799cc80d6ad7fa94ce744 Mon Sep 17 00:00:00 2001
From: Daniel Illescas Romero <illescas.daniel@protonmail.com>
Date: Thu, 8 Oct 2026 20:30:00 +0200
Subject: [PATCH 28/65] P3: bake final Luger ADS tune; ADS crosshair becomes a
 dot

Defaults from the latest codmod_tune.log session. While ADS, show a
center dot (cod_adsCrosshair 1); set 2 later to hide completely.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 SP/code/cgame/cg_cod.c      |  2 +-
 SP/code/cgame/cg_cod_menu.c |  1 +
 SP/code/cgame/cg_draw.c     | 26 ++++++++++++++------------
 SP/code/game/bg_cod.c       | 18 ++++++++++--------
 SP/code/game/bg_cod.h       |  1 +
 5 files changed, 27 insertions(+), 21 deletions(-)

diff --git a/SP/code/cgame/cg_cod.c b/SP/code/cgame/cg_cod.c
index 3e835d63..34c8e917 100644
--- a/SP/code/cgame/cg_cod.c
+++ b/SP/code/cgame/cg_cod.c
@@ -153,7 +153,7 @@ void CG_CodApplyIronSightAds( vec3_t handOrigin, vec3_t angles, int weaponNum, f
 	sightDist   = bg_cod.adsSightDist   + ads->sightDist;
 
 	// codmod: too small = looking inside the mesh; too large = floating mid-screen arms.
-	// Pistol defaults from codmod_tune.log (Dist 18.5 / Height 3 / Yaw -6.5 / Roll 6.5).
+	// Pistol defaults from codmod_tune.log (Dist 20 / Height 2.5 / Yaw -3.5 / Roll 6.5).
 	if ( sightDist < 8.0f ) {
 		sightDist = 8.0f;
 	}
diff --git a/SP/code/cgame/cg_cod_menu.c b/SP/code/cgame/cg_cod_menu.c
index 078f194f..3ce25b38 100644
--- a/SP/code/cgame/cg_cod_menu.c
+++ b/SP/code/cgame/cg_cod_menu.c
@@ -209,6 +209,7 @@ static const codMenuItem_t cg_codMenuItems[] = {
 	{ COD_MI_FLOAT, "cod_adsYaw",             "cod_adsYaw",             0.5f, 2,    NULL },
 	{ COD_MI_FLOAT, "cod_adsRoll",            "cod_adsRoll",            0.5f, 2,    NULL },
 	{ COD_MI_FLOAT, "cod_adsRight",           "cod_adsRight",           0.25f, 1,   NULL },
+	{ COD_MI_INT,   "cod_adsCrosshair",       "cod_adsCrosshair",       1,    1,    NULL },
 
 	{ COD_MI_SECTION, "ADS TUNE (per-weapon live)", NULL, 0, 0, NULL },
 	{ COD_MI_BOOL,  "cod_adsLock",            "cod_adsLock",            1,    1,    NULL },
diff --git a/SP/code/cgame/cg_draw.c b/SP/code/cgame/cg_draw.c
index 67ad9c04..2220bf67 100644
--- a/SP/code/cgame/cg_draw.c
+++ b/SP/code/cgame/cg_draw.c
@@ -2362,18 +2362,6 @@ static void CG_DrawCrosshair( void ) {
 
 	hcolor[3] = cg_crosshairAlpha.value;    //----(SA)	added
 
-	// codmod: fade the crosshair out as ADS comes in, fully hidden past frac 0.6 (phase 3.7).
-	// Uses the raw (non-smoothstepped) fraction -- the gun/FOV easing already hides most of
-	// the pop, and this just needs to clear the dot before it's covered by iron sights.
-	if ( bg_cod.enable && bg_cod.adsEnable ) {
-		float adsFrac = CG_CodAdsFrac();
-		if ( adsFrac > 0.6f ) {
-			hcolor[3] = 0.0f;
-		} else if ( adsFrac > 0.0f ) {
-			hcolor[3] *= ( 1.0f - adsFrac );
-		}
-	}
-
 	if ( cg_fixedAspect.integer ) {
 		CG_SetScreenPlacement(PLACE_CENTER, PLACE_CENTER);
 	}
@@ -2492,6 +2480,20 @@ static void CG_DrawCrosshair( void ) {
 		return;
 	}
 
+	// codmod: while ADS, replace the hip crosshair with a center dot (phase 3.7 interim).
+	// cod_adsCrosshair 1 = dot (default until all weapons are tuned); 2 = hide completely.
+	if ( bg_cod.enable && bg_cod.adsEnable && bg_cod.adsCrosshair > 0 && CG_CodAdsFrac() > 0.5f ) {
+		if ( bg_cod.adsCrosshair >= 2 ) {
+			return;
+		}
+		if ( cg_crosshairHealth.integer ) {
+			CG_ColorForHealth( hcolor );
+		}
+		hcolor[3] = cg_crosshairAlpha.value;
+		CG_FillRect( 319, 239, 2, 2, hcolor );
+		return;
+	}
+
 	// set color based on health
 	if ( cg_crosshairHealth.integer ) {
 		CG_ColorForHealth( hcolor );
diff --git a/SP/code/game/bg_cod.c b/SP/code/game/bg_cod.c
index c091032b..25718a1a 100644
--- a/SP/code/game/bg_cod.c
+++ b/SP/code/game/bg_cod.c
@@ -67,17 +67,19 @@ const codCvarDef_t bg_codCvars[] = {
 	// it doesn't fill the screen from the hip. Used as a fine bias on top of tag_flash align.
 	{ "cod_adsGunFovComp",      "2",    0,            CODOFS( adsGunFovComp ),      0 },
 	// codmod: CoD-style iron-sight auto-align defaults (cgame). Per-weapon table can override.
-	// Luger tune from codmod_tune.log (2026-10-08 session).
-	{ "cod_adsSightHeight",     "3",    0,            CODOFS( adsSightHeight ),     0 },
-	{ "cod_adsBarrelBack",      "11.5", 0,            CODOFS( adsBarrelBack ),      0 },
-	{ "cod_adsSightDist",       "18.5", 0,            CODOFS( adsSightDist ),       0 },
+	// Luger tune from codmod_tune.log (2026-10-08, final session).
+	{ "cod_adsSightHeight",     "2.5",  0,            CODOFS( adsSightHeight ),     0 },
+	{ "cod_adsBarrelBack",      "13",   0,            CODOFS( adsBarrelBack ),      0 },
+	{ "cod_adsSightDist",       "20",   0,            CODOFS( adsSightDist ),       0 },
 	// codmod: RTCW viewmodels are built for hip-fire; tag_flash "straight" can still look
 	// diagonally held. Applied before sight centering (Luger in-game tune).
-	{ "cod_adsPitch",           "1.5",  0,            CODOFS( adsPitch ),           0 },
-	{ "cod_adsYaw",             "-6.5", 0,            CODOFS( adsYaw ),             0 },
+	{ "cod_adsPitch",           "-1",   0,            CODOFS( adsPitch ),           0 },
+	{ "cod_adsYaw",             "-3.5", 0,            CODOFS( adsYaw ),             0 },
 	{ "cod_adsRoll",            "6.5",  0,            CODOFS( adsRoll ),            0 },
-	// codmod: whole-weapon horizontal shift (viewaxis[1]); tune in /cod_menu. 0 = centered.
-	{ "cod_adsRight",           "0",    0,            CODOFS( adsRight ),           0 },
+	// codmod: whole-weapon horizontal shift (viewaxis[1]); tune in /cod_menu.
+	{ "cod_adsRight",           "1",    0,            CODOFS( adsRight ),           0 },
+	// codmod: 1 = center dot while ADS (interim); 2 = hide (once all weapons are tuned).
+	{ "cod_adsCrosshair",       "1",    0,            CODOFS( adsCrosshair ),       1 },
 	{ "cod_scopeSwitchTime",    "0",    0,            CODOFS( scopeSwitchTime ),    0 },
 
 	// codmod: Phase 3.5 alignment tooling -- see docs/phase-3-ads.md "Alignment tooling".
diff --git a/SP/code/game/bg_cod.h b/SP/code/game/bg_cod.h
index c7cf8824..b3dc6c08 100644
--- a/SP/code/game/bg_cod.h
+++ b/SP/code/game/bg_cod.h
@@ -61,6 +61,7 @@ typedef struct {
 	float adsYaw;           // degrees, global ADS angle bias (neg = clockwise from above)
 	float adsRoll;          // degrees, global ADS angle bias (pos ≈ clockwise looking forward)
 	float adsRight;         // u, whole-weapon horizontal shift along view right/left (cgame)
+	int adsCrosshair;       // 0=keep hip crosshair, 1=ADS center dot (default), 2=hide while ADS
 	float scopeSwitchTime;  // ms, rifle<->scope weapon-change time when >0 (phase 3.8); 0 = vanilla 250ms
 
 	int adsLock;      // debug: cgame treats ADS as fully in, visual only (alignment tooling)
-- 
2.56.0

