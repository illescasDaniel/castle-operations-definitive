+			if ( sprintE > 0.0f && CG_CodAdsFrac() <= 0.01f ) {
+				fov_x *= 1.0f + ( bg_cod.sprintFovScale - 1.0f ) * sprintE;
+			}
+		}
 	}
 
 	// DHM - Nerve :: zoom in for Limbo or Spectator
