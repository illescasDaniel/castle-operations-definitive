 	int delta;
 	float fracsin, leanscale;
 	float bobScale;    // codmod: phase 3.5, see below -- 1 outside ADS, down to 1-adsBobScale at full ADS
+	float gaitAmp;     // codmod: phase 4.2 walk/jog/sprint bob amp
