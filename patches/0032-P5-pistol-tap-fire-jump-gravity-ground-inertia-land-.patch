 };
 
+/*
+================
+BG_CodIsPistol
+
+codmod: weapons that get SP tap-fire / pistol interval overrides (phase 5).
+================
+*/
+qboolean BG_CodIsPistol( int weapon ) {
+	return ( weapon == WP_LUGER || weapon == WP_COLT || weapon == WP_SILENCER ) ? qtrue : qfalse;
+}
+
 /*
 ================
