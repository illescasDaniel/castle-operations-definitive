From 43f1db67072257b3445546d1278e3f4a568e1d9e Mon Sep 17 00:00:00 2001
From: Daniel Illescas Romero <illescas.daniel@protonmail.com>
Date: Thu, 8 Oct 2026 23:28:28 +0200
Subject: [PATCH 34/64] =?UTF-8?q?P5:=20snappier=20quickknife=20=E2=80=94?=
 =?UTF-8?q?=2075ms=20knife=20switch,=20return=20on=20swing?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

cod_knifeSwitchTime shortens drop/raise to/from knife; cgame returns
to the previous weapon as soon as the swing registers instead of
waiting out knife READY, so V feels tied to the press.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 SP/code/cgame/cg_cod.c      | 18 ++++++++----------
 SP/code/cgame/cg_cod_menu.c |  1 +
 SP/code/game/bg_cod.c       |  4 +++-
 SP/code/game/bg_cod.h       |  1 +
 SP/code/game/bg_pmove.c     | 14 ++++++++++++++
 5 files changed, 27 insertions(+), 11 deletions(-)

diff --git a/SP/code/cgame/cg_cod.c b/SP/code/cgame/cg_cod.c
index 95e13f19..4d3ccc55 100644
--- a/SP/code/cgame/cg_cod.c
+++ b/SP/code/cgame/cg_cod.c
@@ -884,22 +884,20 @@ void CG_CodUpdateQuickKnife( void ) {
 
 		if ( cg.codQkAttackHeld ) {
 			if ( ps->weaponstate == WEAPON_FIRING || ps->weaponTime > 0 ) {
+				// Swing registered — release attack and return immediately (don't wait out
+				// knife nextShotTime / READY). Keeps V feeling tied to the press.
 				cg.codQkSawFire = qtrue;
 				trap_SendConsoleCommand( "-attack\n" );
 				cg.codQkAttackHeld = qfalse;
+				if ( cg.codQkStayOnKnife || cg.codQkPrev <= WP_NONE ) {
+					CG_CodQuickKnifeClear();
+					return;
+				}
+				cg.codQkState = COD_QK_RETURNING;
+				CG_FinishWeaponChange( WP_KNIFE, cg.codQkPrev );
 			}
 			return;
 		}
-
-		if ( cg.codQkSawFire && ps->weaponstate == WEAPON_READY && ps->weaponTime <= 0 ) {
-			if ( cg.codQkStayOnKnife || cg.codQkPrev <= WP_NONE ) {
-				CG_CodQuickKnifeClear();
-				return;
-			}
-			cg.codQkState = COD_QK_RETURNING;
-			CG_FinishWeaponChange( WP_KNIFE, cg.codQkPrev );
-			return;
-		}
 		return;
 	}
 
diff --git a/SP/code/cgame/cg_cod_menu.c b/SP/code/cgame/cg_cod_menu.c
index 63f637e3..bd6cb3b0 100644
--- a/SP/code/cgame/cg_cod_menu.c
+++ b/SP/code/cgame/cg_cod_menu.c
@@ -222,6 +222,7 @@ static const codMenuItem_t cg_codMenuItems[] = {
 	{ COD_MI_FLOAT, "cod_autoFireScale",      "cod_autoFireScale",      0.05f, 0.25f, NULL },
 	{ COD_MI_BOOL,  "cod_quickKnifeEnable",   "cod_quickKnifeEnable",   1,    1,    NULL },
 	{ COD_MI_FLOAT, "cod_quickKnifeTimeout",  "cod_quickKnifeTimeout",  50,   200,  NULL },
+	{ COD_MI_FLOAT, "cod_knifeSwitchTime",    "cod_knifeSwitchTime",    5,    25,   NULL },
 
 	{ COD_MI_SECTION, "CROUCH / DUCK", NULL, 0, 0, NULL },
 	{ COD_MI_FLOAT, "cod_duckTime",           "cod_duckTime",           5,    25,   NULL },
diff --git a/SP/code/game/bg_cod.c b/SP/code/game/bg_cod.c
index caa055c0..52053c2c 100644
--- a/SP/code/game/bg_cod.c
+++ b/SP/code/game/bg_cod.c
@@ -131,7 +131,9 @@ const codCvarDef_t bg_codCvars[] = {
 	{ "cod_landSlowScale",      "0.55", 0,            CODOFS( landSlowScale ),      0 },
 
 	{ "cod_quickKnifeEnable",   "1",    0,            CODOFS( quickKnifeEnable ),   1 },
-	{ "cod_quickKnifeTimeout",  "1200", 0,            CODOFS( quickKnifeTimeout ),  0 },
+	{ "cod_quickKnifeTimeout",  "900",  0,            CODOFS( quickKnifeTimeout ),  0 },
+	// codmod: snappy knife pull (was 250+250). 75 keeps anim readable but CoD-connected.
+	{ "cod_knifeSwitchTime",    "75",   0,            CODOFS( knifeSwitchTime ),    0 },
 
 	{ "cod_debugHud",           "0",    CVAR_ARCHIVE, CODOFS( debugHud ),           1 },
 	// codmod: /cod_menu overlay size (cgame). Archived like cod_debugHud — UI preference.
diff --git a/SP/code/game/bg_cod.h b/SP/code/game/bg_cod.h
index 216cebb1..d5dab1e5 100644
--- a/SP/code/game/bg_cod.h
+++ b/SP/code/game/bg_cod.h
@@ -105,6 +105,7 @@ typedef struct {
 
 	int quickKnifeEnable;      // cgame quickknife command (phase 5.5)
 	float quickKnifeTimeout;   // ms failsafe to return to previous weapon
+	float knifeSwitchTime;     // ms drop/raise when switching to/from knife (0 = vanilla 250)
 
 	int debugHud;    // 0 off, 1 HUD, 2 HUD + nearest AI speed
 	float menuScale; // /cod_menu text+panel scale (0.5..1.0); cgame UI preference
diff --git a/SP/code/game/bg_pmove.c b/SP/code/game/bg_pmove.c
index e04f286c..7d54b1f9 100644
--- a/SP/code/game/bg_pmove.c
+++ b/SP/code/game/bg_pmove.c
@@ -2256,6 +2256,13 @@ static void PM_BeginWeaponChange( int oldweapon, int newweapon, qboolean reload
 		}
 	}
 
+	// codmod: snappy knife in/out for quickknife + weaponbank 1 (phase 5.5). Player only.
+	if ( !pm->ps->aiChar && bg_cod.enable && bg_cod.quickKnifeEnable
+		 && bg_cod.knifeSwitchTime > 0
+		 && ( oldweapon == WP_KNIFE || newweapon == WP_KNIFE ) ) {
+		switchtime = (int)bg_cod.knifeSwitchTime;
+	}
+
 	pm->ps->weaponTime += switchtime;
 }
 
@@ -2346,6 +2353,13 @@ static void PM_FinishWeaponChange( void ) {
 		}
 	}
 
+	// codmod: snappy knife raise (phase 5.5) — mirrors BeginWeaponChange drop override
+	if ( !pm->ps->aiChar && bg_cod.enable && bg_cod.quickKnifeEnable
+		 && bg_cod.knifeSwitchTime > 0
+		 && ( oldweapon == WP_KNIFE || newweapon == WP_KNIFE ) ) {
+		switchtime = (int)bg_cod.knifeSwitchTime;
+	}
+
 	pm->ps->weaponTime += switchtime;
 
 	// make scripting aware of new weapon
-- 
2.56.0

