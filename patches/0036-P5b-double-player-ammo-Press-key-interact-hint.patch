From 84f6724ae6ad416be26ba604e2c7a4df622fc52e Mon Sep 17 00:00:00 2001
From: Daniel Illescas Romero <illescas.daniel@protonmail.com>
Date: Thu, 8 Oct 2026 23:43:18 +0200
Subject: [PATCH 36/65] P5b: double player ammo + Press-key interact hint

cod_ammoScale 2 multiplies Add_Ammo grants and max carry for the
player only. Cursor hints for doors/activate show "Press <key> to
interact" using the current +activate binding.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 SP/code/cgame/cg_cod_menu.c |  2 ++
 SP/code/cgame/cg_newdraw.c  | 54 +++++++++++++++++++++++++++++++++++++
 SP/code/game/bg_cod.c       | 23 ++++++++++++++++
 SP/code/game/bg_cod.h       |  5 ++++
 SP/code/game/bg_misc.c      |  7 +++--
 SP/code/game/g_items.c      | 23 ++++++++++++++--
 6 files changed, 110 insertions(+), 4 deletions(-)

diff --git a/SP/code/cgame/cg_cod_menu.c b/SP/code/cgame/cg_cod_menu.c
index f21403c4..7fcbfdf4 100644
--- a/SP/code/cgame/cg_cod_menu.c
+++ b/SP/code/cgame/cg_cod_menu.c
@@ -198,6 +198,8 @@ static const codMenuItem_t cg_codMenuItems[] = {
 	{ COD_MI_FLOAT, "cod_healthRegenRate",    "cod_healthRegenRate",    1,     5,    NULL },
 	{ COD_MI_BOOL,  "cod_healthRegenPauseHurt","cod_healthRegenPauseHurt", 1,  1,    NULL },
 	{ COD_MI_BOOL,  "cod_healthBarNumber",    "cod_healthBarNumber",    1,     1,    NULL },
+	{ COD_MI_FLOAT, "cod_ammoScale",          "cod_ammoScale",          0.25f, 1,    NULL },
+	{ COD_MI_BOOL,  "cod_interactHint",       "cod_interactHint",       1,     1,    NULL },
 
 	{ COD_MI_SECTION, "GAIT / SPRINT GUN", NULL, 0, 0, NULL },
 	{ COD_MI_FLOAT, "cod_sprintRaiseTime",    "cod_sprintRaiseTime",    10,   50,   NULL },
diff --git a/SP/code/cgame/cg_newdraw.c b/SP/code/cgame/cg_newdraw.c
index 2ed9ca80..5b6d7e98 100644
--- a/SP/code/cgame/cg_newdraw.c
+++ b/SP/code/cgame/cg_newdraw.c
@@ -526,6 +526,60 @@ static void CG_DrawCursorhint( rectDef_t *rect ) {
 
 	trap_R_SetColor( NULL );
 
+	// codmod: "Press <key> to interact" beside usable/door hints (phase 5b).
+	// Key comes from the current +activate binding via trap_Key_GetKey.
+	if ( bg_cod.enable && bg_cod.vitalsEnable && bg_cod.interactHint ) {
+		qboolean showInteract = qfalse;
+
+		switch ( cg.cursorHintIcon ) {
+		case HINT_ACTIVATE:
+		case HINT_DOOR:
+		case HINT_DOOR_ROTATING:
+		case HINT_BUTTON:
+		case HINT_BREAKABLE:
+		case HINT_CHAIR:
+			showInteract = qtrue;
+			break;
+		default:
+			break;
+		}
+		if ( showInteract && cg.cursorHintIcon == HINT_CHAIR
+			 && cg.predictedPlayerState.weapon
+			 && !( WEAPS_ONE_HANDED & ( 1 << ( cg.predictedPlayerState.weapon ) ) ) ) {
+			showInteract = qfalse; // armed two-hand: chair shows NOACTIVATE
+		}
+		if ( showInteract ) {
+			char keyName[16];
+			char hintText[64];
+			int key;
+			vec4_t textColor;
+
+			key = trap_Key_GetKey( "+activate" );
+			if ( key <= 0 ) {
+				Q_strncpyz( keyName, "F", sizeof( keyName ) );
+			} else if ( key > 32 && key < 127 && key != '"' ) {
+				if ( key >= 'a' && key <= 'z' ) {
+					keyName[0] = (char)( key - 32 );
+				} else {
+					keyName[0] = (char)key;
+				}
+				keyName[1] = 0;
+			} else if ( key == 13 ) { // K_ENTER
+				Q_strncpyz( keyName, "ENTER", sizeof( keyName ) );
+			} else if ( key == 32 ) { // K_SPACE
+				Q_strncpyz( keyName, "SPACE", sizeof( keyName ) );
+			} else {
+				Q_strncpyz( keyName, "F", sizeof( keyName ) );
+			}
+
+			Com_sprintf( hintText, sizeof( hintText ), "Press %s to interact", keyName );
+			Vector4Copy( color, textColor );
+			CG_DrawSmallStringColor( (int)( rect->x + rect->w + 6 ),
+									(int)( rect->y + rect->h * 0.35f ),
+									hintText, textColor );
+		}
+	}
+
 	// draw status bar under the cursor hint
 	if ( cg.cursorHintValue && ( !( cg.time - cg.cursorHintTime ) ) ) {    // don't fade bar out w/ hint icon
 		if ( redbar ) {
diff --git a/SP/code/game/bg_cod.c b/SP/code/game/bg_cod.c
index 82682858..b0a6fd12 100644
--- a/SP/code/game/bg_cod.c
+++ b/SP/code/game/bg_cod.c
@@ -147,6 +147,8 @@ const codCvarDef_t bg_codCvars[] = {
 	{ "cod_maxHealth",          "50",   0,            CODOFS( maxHealth ),          0 },
 	{ "cod_sprintLinear",       "1",    0,            CODOFS( sprintLinear ),       1 },
 	{ "cod_sprintRechargeDelay","600",  0,            CODOFS( sprintRechargeDelay ), 0 },
+	{ "cod_ammoScale",          "2",    0,            CODOFS( ammoScale ),          0 },
+	{ "cod_interactHint",       "1",    0,            CODOFS( interactHint ),       1 },
 
 	{ "cod_debugHud",           "0",    CVAR_ARCHIVE, CODOFS( debugHud ),           1 },
 	// codmod: /cod_menu overlay size (cgame). Archived like cod_debugHud — UI preference.
@@ -252,6 +254,27 @@ qboolean BG_CodIsPistol( int weapon ) {
 	return ( weapon == WP_LUGER || weapon == WP_COLT || weapon == WP_SILENCER ) ? qtrue : qfalse;
 }
 
+/*
+================
+BG_CodMaxAmmo
+
+codmod: scaled max reserve for the player when cod_ammoScale > 1 (phase 5b).
+Does not mutate ammoTable (shared with AI).
+================
+*/
+int BG_CodMaxAmmo( int weapon ) {
+	int maxa;
+
+	if ( weapon < 0 || weapon >= WP_NUM_WEAPONS ) {
+		return 0;
+	}
+	maxa = ammoTable[weapon].maxammo;
+	if ( bg_cod.enable && bg_cod.vitalsEnable && bg_cod.ammoScale > 1.0f ) {
+		maxa = (int)( maxa * bg_cod.ammoScale + 0.5f );
+	}
+	return maxa;
+}
+
 /*
 ================
 BG_CodCanADS
diff --git a/SP/code/game/bg_cod.h b/SP/code/game/bg_cod.h
index 85068e7d..71c57568 100644
--- a/SP/code/game/bg_cod.h
+++ b/SP/code/game/bg_cod.h
@@ -117,6 +117,8 @@ typedef struct {
 	float maxHealth;           // player STAT_MAX_HEALTH when > 0 (vanilla 100; CoD-ish 50)
 	int sprintLinear;          // single-rate recharge (no 25%/idle bonuses)
 	float sprintRechargeDelay; // ms after sprint ends before recharge starts
+	float ammoScale;           // × pickup/start ammo + max carry (player only; 2 = double)
+	int interactHint;          // cgame: "Press <key> to interact" next to cursor hint
 
 	int debugHud;    // 0 off, 1 HUD, 2 HUD + nearest AI speed
 	float menuScale; // /cod_menu text+panel scale (0.5..1.0); cgame UI preference
@@ -190,4 +192,7 @@ int BG_CodAdsTimeOut( int weapon );
 // real RTCW scope instead of iron-sight ADS, but still get the ADS move-speed penalty.
 qboolean BG_CodIsScopeWeapon( int weapon );
 
+// codmod: player max reserve ammo after cod_ammoScale (phase 5b). AI / scale≤1 → table maxammo.
+int BG_CodMaxAmmo( int weapon );
+
 #endif // __BG_COD_H__
diff --git a/SP/code/game/bg_misc.c b/SP/code/game/bg_misc.c
index 98f64645..bdc1f34c 100644
--- a/SP/code/game/bg_misc.c
+++ b/SP/code/game/bg_misc.c
@@ -36,6 +36,7 @@ If you have questions concerning this license or the applicable additional terms
 
 #include "../qcommon/q_shared.h"
 #include "bg_public.h"
+#include "bg_cod.h"     // codmod: phase 5b BG_CodMaxAmmo for pickup checks
 
 
 #ifdef CGAMEDLL
@@ -3883,7 +3884,8 @@ qboolean    BG_CanItemBeGrabbed( const entityState_t *ent, const playerState_t *
 						return qfalse;
 					}
 				} else {
-					if ( ps->ammo[item->giAmmoIndex] >= ammoTable[item->giAmmoIndex].maxammo ) { // you are loaded with the ammo
+					// codmod: scaled max carry for player (phase 5b)
+					if ( ps->ammo[item->giAmmoIndex] >= BG_CodMaxAmmo( item->giAmmoIndex ) ) {
 						return qfalse;
 					}
 				}
@@ -3901,7 +3903,8 @@ qboolean    BG_CanItemBeGrabbed( const entityState_t *ent, const playerState_t *
 			}
 		}
 
-		if ( ps->ammo[ammoweap] >= ammoTable[ammoweap].maxammo ) {
+		// codmod: scaled max carry for player (phase 5b)
+		if ( ps->ammo[ammoweap] >= BG_CodMaxAmmo( ammoweap ) ) {
 			return qfalse;
 		}
 
diff --git a/SP/code/game/g_items.c b/SP/code/game/g_items.c
index 2413aa91..cacef2d1 100644
--- a/SP/code/game/g_items.c
+++ b/SP/code/game/g_items.c
@@ -39,6 +39,7 @@ If you have questions concerning this license or the applicable additional terms
 */
 
 #include "g_local.h"
+#include "bg_cod.h"     // codmod: phase 5b ammoScale
 
 
 
@@ -317,6 +318,18 @@ Add_Ammo
 void Add_Ammo( gentity_t *ent, int weapon, int count, qboolean fillClip ) {
 	int ammoweap = BG_FindAmmoForWeapon( weapon );
 	qboolean noPack = qfalse;       // no extra ammo in your 'pack'
+	int maxAmmo;
+
+	// codmod: double (or scale) ammo given to the player — pickups, weapon grants, scripts.
+	// Skip the "give all" path (count >= 999) and AI. (phase 5b)
+	if ( ent->client && !ent->aiCharacter && !ent->client->ps.aiChar
+		 && bg_cod.enable && bg_cod.vitalsEnable && bg_cod.ammoScale > 1.0f
+		 && count > 0 && count < 999 ) {
+		count = (int)( count * bg_cod.ammoScale + 0.5f );
+		if ( count < 1 ) {
+			count = 1;
+		}
+	}
 
 	ent->client->ps.ammo[ammoweap] += count;
 
@@ -348,8 +361,14 @@ void Add_Ammo( gentity_t *ent, int weapon, int count, qboolean fillClip ) {
 	if ( noPack ) {
 		ent->client->ps.ammo[ammoweap] = 0;
 	} else {
-		if ( ent->client->ps.ammo[ammoweap] > ammoTable[ammoweap].maxammo ) {
-			ent->client->ps.ammo[ammoweap] = ammoTable[ammoweap].maxammo;
+		// codmod: player uses scaled max carry when ammoScale > 1 (phase 5b)
+		if ( ent->client && !ent->aiCharacter && !ent->client->ps.aiChar ) {
+			maxAmmo = BG_CodMaxAmmo( ammoweap );
+		} else {
+			maxAmmo = ammoTable[ammoweap].maxammo;
+		}
+		if ( ent->client->ps.ammo[ammoweap] > maxAmmo ) {
+			ent->client->ps.ammo[ammoweap] = maxAmmo;
 		}
 
 		if ( count >= 999 ) { // 'really, give /all/'
