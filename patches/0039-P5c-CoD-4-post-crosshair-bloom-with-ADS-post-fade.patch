 SP/code/cgame/cg_cod_menu.c |  12 +++
 SP/code/cgame/cg_draw.c     |  37 ++++----
 SP/code/cgame/cg_local.h    |   1 +
 SP/code/game/bg_cod.c       |  13 +++
 SP/code/game/bg_cod.h       |  12 +++
 6 files changed, 230 insertions(+), 15 deletions(-)

diff --git a/SP/code/cgame/cg_cod.c b/SP/code/cgame/cg_cod.c
index 17aadab8..208aeb38 100644
--- a/SP/code/cgame/cg_cod.c
+++ b/SP/code/cgame/cg_cod.c
@@ -1064,3 +1064,173 @@ void CG_CodDrawLowHealthBlood( void ) {
