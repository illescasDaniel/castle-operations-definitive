@@ -1234,3 +1234,174 @@ void CG_CodDrawCrosshair( const vec4_t hcolor ) {
 		CG_CodDrawCrosshairBar( cx - 1.0f, cy - 1.0f, 2.0f, 2.0f, dotColor );
