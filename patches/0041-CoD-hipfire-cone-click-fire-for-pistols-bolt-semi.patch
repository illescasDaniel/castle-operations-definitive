+
+// codmod: player fire cone — hip floor lerps to ADS-tightened spread by adsFrac (0..1).
+float BG_CodFireSpreadScale( float aimSpread, int weapon, float adsFrac );
+
 // codmod: generic smoothstep ease, 0..1 in, 0..1 out (phase 3.5+). GCC doesn't warn about
 // unused "static inline" functions, so qagame linking this header unused is fine.
 static ID_INLINE float BG_CodSmoothstep( float x ) {
diff --git a/SP/code/game/bg_pmove.c b/SP/code/game/bg_pmove.c
index ecad3300..3097888a 100644
--- a/SP/code/game/bg_pmove.c
+++ b/SP/code/game/bg_pmove.c
@@ -2861,6 +2861,13 @@ static void PM_Weapon( void ) {
 	qboolean akimboFire;
 	qboolean gameReloading;
 
+	// codmod: track attack release for click-fire weapons (and pistol tap-fire).
+	// Vanilla only set releasedFire inside pistol-specific blocks; bolt/semi need it too.
+	// Runs before the respawn gate so the first post-spawn click is allowed.
+	if ( !pm->ps->aiChar && !( pm->cmd.buttons & BUTTON_ATTACK ) ) {
+		pm->ps->releasedFire = qtrue;
+	}
+
 	// don't allow attack until all buttons are up
 	if ( pm->ps->pm_flags & PMF_RESPAWNED ) {
 		return;
@@ -3229,6 +3236,15 @@ static void PM_Weapon( void ) {
 		return;
 	}
 
+	// codmod: CoD fire modes — pistols / bolt / semi fire once per click; holding only
+	// keeps spraying on automatics (MP40 / Thompson / Sten / FG42 / Venom / flame).
+	if ( !pm->ps->aiChar && bg_cod.enable && bg_cod.weaponEnable && bg_cod.semiAutoClick
+		 && BG_CodNeedsClickFire( pm->ps->weapon ) && !delayedFire
+		 && !pm->ps->releasedFire ) {
+		pm->ps->weaponstate = WEAPON_READY;
+		return;
+	}
+
 	if ( gameReloading ) {
 		return;
 	}
