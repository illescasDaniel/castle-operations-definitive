From 0c3ced34293a7aa7146773c7cad65b566b66dc09 Mon Sep 17 00:00:00 2001
From: Daniel Illescas Romero <illescas.daniel@protonmail.com>
Date: Fri, 9 Oct 2026 11:36:25 +0200
Subject: [PATCH 44/64] P5d follow-up: flashlight force-dlight, reload anim
 race, pistol 200ms.
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Flashlight used REF_FORCE_DLIGHT + forward trace (r_dynamiclight was 0).
Reload: do not stomp WEAP_RELOAD from late EV_FIRE; empty-clip path
calls PM_BeginWeaponReload. Pistol nextShot default 120 → 200 ms.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 SP/code/cgame/cg_cod.c     | 30 +++++++++++++++++++++++++-----
 SP/code/cgame/cg_weapons.c | 20 +++++++++++++-------
 SP/code/game/bg_cod.c      |  5 +++--
 SP/code/game/bg_pmove.c    |  4 +++-
 4 files changed, 44 insertions(+), 15 deletions(-)

diff --git a/SP/code/cgame/cg_cod.c b/SP/code/cgame/cg_cod.c
index b39cad96..fae785ea 100644
--- a/SP/code/cgame/cg_cod.c
+++ b/SP/code/cgame/cg_cod.c
@@ -765,13 +765,17 @@ codmod: client-local view flashlight (phase 5d). RTCW SP has no player lamp.
 void CG_ToggleFlashlight_f( void ) {
 	if ( !( bg_cod.enable && bg_cod.flashlightEnable ) ) {
 		cg.codFlashlightOn = qfalse;
+		CG_Printf( "Flashlight disabled (cod_flashlightEnable 0).\n" );
 		return;
 	}
 	cg.codFlashlightOn = !cg.codFlashlightOn;
+	CG_Printf( "Flashlight %s\n", cg.codFlashlightOn ? "ON" : "OFF" );
 }
 
 void CG_CodAddFlashlight( void ) {
-	vec3_t origin;
+	vec3_t start, end, lightPos;
+	trace_t tr;
+	float intensity;
 
 	if ( !cg.codFlashlightOn ) {
 		return;
@@ -786,10 +790,26 @@ void CG_CodAddFlashlight( void ) {
 		return;
 	}
 
-	// Slightly forward of the eye so the light is not buried in the head hull.
-	VectorMA( cg.refdef.vieworg, 16.0f, cg.refdef.viewaxis[0], origin );
-	trap_R_AddLightToScene( origin, bg_cod.flashlightIntensity,
-							bg_cod.flashlightR, bg_cod.flashlightG, bg_cod.flashlightB, 0 );
+	intensity = bg_cod.flashlightIntensity;
+	if ( intensity < 1.0f ) {
+		intensity = 350.0f;
+	}
+
+	// Trace ahead so the beam lights walls (point light at the eye alone is easy to miss).
+	// REF_FORCE_DLIGHT: wolfconfig often has r_dynamiclight 0 — without FORCE the light is dropped.
+	VectorCopy( cg.refdef.vieworg, start );
+	VectorMA( start, 768.0f, cg.refdef.viewaxis[0], end );
+	CG_Trace( &tr, start, NULL, NULL, end, cg.snap->ps.clientNum, MASK_SHOT );
+	VectorMA( start, 32.0f + 200.0f * tr.fraction, cg.refdef.viewaxis[0], lightPos );
+
+	trap_R_AddLightToScene( lightPos, intensity * ( 0.55f + 0.45f * tr.fraction ),
+							bg_cod.flashlightR, bg_cod.flashlightG, bg_cod.flashlightB,
+							REF_FORCE_DLIGHT );
+	// Soft fill near the view so close geometry is lit too.
+	VectorMA( start, 24.0f, cg.refdef.viewaxis[0], lightPos );
+	trap_R_AddLightToScene( lightPos, intensity * 0.35f,
+							bg_cod.flashlightR, bg_cod.flashlightG, bg_cod.flashlightB,
+							REF_FORCE_DLIGHT );
 }
 
 /*
diff --git a/SP/code/cgame/cg_weapons.c b/SP/code/cgame/cg_weapons.c
index c22d1ab1..49fd56db 100644
--- a/SP/code/cgame/cg_weapons.c
+++ b/SP/code/cgame/cg_weapons.c
@@ -4842,7 +4842,9 @@ void CG_FireWeapon( centity_t *cent ) {
 		// IDLE in one batch so weapAnim is already IDLE when this runs —
 		// Clear against IDLE = no kick. Force ATTACK if needed, then clear
 		// on the predicted hands entity (event cent may be a different pe).
+		// Do NOT stomp an in-progress reload (empty-clip auto-reload race).
 		if ( bg_cod.enable && !cg.renderingThirdPerson
+			 && cg.predictedPlayerState.weaponstate != WEAPON_RELOADING
 			 && ent->weapon != WP_FLAMETHROWER
 			 && ent->weapon != WP_GRENADE_LAUNCHER
 			 && ent->weapon != WP_GRENADE_PINEAPPLE
@@ -4850,14 +4852,18 @@ void CG_FireWeapon( centity_t *cent ) {
 			 && ent->weapon != WP_KNIFE ) {
 			int anim = cg.predictedPlayerState.weapAnim & ~ANIM_TOGGLEBIT;
 
-			if ( anim != WEAP_ATTACK1 && anim != WEAP_ATTACK2
-				 && anim != WEAP_ATTACK_LASTSHOT ) {
-				anim = WEAP_ATTACK1;
-				cg.predictedPlayerState.weapAnim =
-					( ( cg.predictedPlayerState.weapAnim & ANIM_TOGGLEBIT ) ^ ANIM_TOGGLEBIT ) | anim;
+			if ( anim == WEAP_RELOAD1 || anim == WEAP_RELOAD2 || anim == WEAP_RELOAD3 ) {
+				// late EV_FIRE from last round — leave reload alone
+			} else {
+				if ( anim != WEAP_ATTACK1 && anim != WEAP_ATTACK2
+					 && anim != WEAP_ATTACK_LASTSHOT ) {
+					anim = WEAP_ATTACK1;
+					cg.predictedPlayerState.weapAnim =
+						( ( cg.predictedPlayerState.weapAnim & ANIM_TOGGLEBIT ) ^ ANIM_TOGGLEBIT ) | anim;
+				}
+				CG_ClearWeapLerpFrame( weap, &cg.predictedPlayerEntity.pe.weap,
+									   cg.predictedPlayerState.weapAnim );
 			}
-			CG_ClearWeapLerpFrame( weap, &cg.predictedPlayerEntity.pe.weap,
-								   cg.predictedPlayerState.weapAnim );
 		}
 	}
 
