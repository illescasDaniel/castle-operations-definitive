From 06c57cec4c2dbbbf5dc3278ebac21008a436c016 Mon Sep 17 00:00:00 2001
From: Daniel Illescas Romero <illescas.daniel@protonmail.com>
Date: Fri, 9 Oct 2026 11:49:21 +0200
Subject: [PATCH 46/64] P6 follow-up: stand after slide; link bg_cod into UI.

Clear duck + sticky crouch when the slide ends (CoD). UI needs bg_cod.o
for BG_CodMaxAmmo or save/load fails to load ui.sp.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 SP/Makefile             |  1 +
 SP/code/cgame/cg_cod.c  | 12 ++++++++++++
 SP/code/game/bg_pmove.c | 17 ++++++++++++++++-
 3 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/SP/Makefile b/SP/Makefile
index 7cca8158..93864446 100644
--- a/SP/Makefile
+++ b/SP/Makefile
@@ -2645,6 +2645,7 @@ Q3UIOBJ_ = \
   $(B)/$(BASEGAME)/ui/ui_shared.o \
   \
   $(B)/$(BASEGAME)/ui/bg_misc.o \
+  $(B)/$(BASEGAME)/ui/bg_cod.o \
   $(B)/$(BASEGAME)/ui/bg_lib.o \
   \
   $(B)/$(BASEGAME)/qcommon/q_math.o \
diff --git a/SP/code/cgame/cg_cod.c b/SP/code/cgame/cg_cod.c
index 1b70b89b..851c95b7 100644
--- a/SP/code/cgame/cg_cod.c
+++ b/SP/code/cgame/cg_cod.c
@@ -807,6 +807,18 @@ void CG_ToggleCrouch_f( void ) {
 }
 
 void CG_CodUpdateToggleCrouch( void ) {
+	static qboolean wasSliding;
+	qboolean sliding;
+
+	// codmod: CoD stands after a slide — clear sticky toggle crouch so the next CheckDuck
+	// does not immediately re-duck (phase 6 follow-up).
+	sliding = ( cg.predictedPlayerState.pm_flags & PMF_COD_SLIDING ) ? qtrue : qfalse;
+	if ( wasSliding && !sliding && cg.codCrouchHeld ) {
+		cg.codCrouchHeld = qfalse;
+		trap_SendConsoleCommand( "-movedown\n" );
+	}
+	wasSliding = sliding;
+
 	if ( !cg.codCrouchHeld ) {
 		return;
 	}
diff --git a/SP/code/game/bg_pmove.c b/SP/code/game/bg_pmove.c
index 6b55489d..54186133 100644
--- a/SP/code/game/bg_pmove.c
+++ b/SP/code/game/bg_pmove.c
@@ -3800,11 +3800,14 @@ static void PM_DropTimers( void ) {
 ================
 PM_CodEndSlide
 
-codmod: clear slide flag, start cooldown (phase 6). PMF_DUCKED stays for hand-off to crouch.
+codmod: clear slide flag, start cooldown (phase 6). Stand up when there is headroom
+(CoD-style — slide does not leave you crouched). Sticky toggle crouch is cleared on the
+client when PMF_COD_SLIDING falls (CG_CodUpdateToggleCrouch).
 ================
 */
 static void PM_CodEndSlide( void ) {
 	int cd;
+	trace_t trace;
 
 	pm->ps->pm_flags &= ~PMF_COD_SLIDING;
 	cd = (int)bg_cod.slideCooldown;
@@ -3813,6 +3816,18 @@ static void PM_CodEndSlide( void ) {
 	}
 	pm->ps->stats[STAT_COD_SLIDE] = -cd;
 	pm->ps->stats[STAT_COD_SLIDE_SPEED] = 0;
+
+	// try to stand (same trace as PM_CheckDuck); stay ducked under a low ceiling
+	pm->maxs[2] = pm->ps->maxs[2];
+	pm->trace( &trace, pm->ps->origin, pm->mins, pm->maxs, pm->ps->origin, pm->ps->clientNum, pm->tracemask );
+	if ( !trace.allsolid ) {
+		pm->ps->pm_flags &= ~PMF_DUCKED;
+		pm->ps->viewheight = pm->ps->standViewHeight;
+	} else {
+		pm->maxs[2] = pm->ps->crouchMaxZ;
+		pm->ps->pm_flags |= PMF_DUCKED;
+		pm->ps->viewheight = pm->ps->crouchViewHeight;
+	}
 }
 
