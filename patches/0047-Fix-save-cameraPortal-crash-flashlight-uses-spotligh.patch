From 4fbc17cb3068b5bf2cc79b753be0a4a64cdce1dc Mon Sep 17 00:00:00 2001
From: Daniel Illescas Romero <illescas.daniel@protonmail.com>
Date: Fri, 9 Oct 2026 12:01:03 +0200
Subject: [PATCH 47/65] Fix save cameraPortal crash; flashlight uses spotlight
 beam.

Ignore raw cameraPortal/persistantPowerup pointers on load (legacy saves
stored garbage addresses and SIGSEGV'd in ClientThink_real). Flashlight
draws CG_Spotlight cone/core/impact with SL_NOMODEL plus forced dlights.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 SP/code/cgame/cg_cod.c     | 54 +++++++++++++++++++++++++++++---------
 SP/code/cgame/cg_effects.c | 11 ++++----
 SP/code/cgame/cg_local.h   |  1 +
 SP/code/game/g_active.c    | 13 ++++++---
 SP/code/game/g_save.c      | 10 +++++++
 5 files changed, 68 insertions(+), 21 deletions(-)

diff --git a/SP/code/cgame/cg_cod.c b/SP/code/cgame/cg_cod.c
index 851c95b7..018915d7 100644
--- a/SP/code/cgame/cg_cod.c
+++ b/SP/code/cgame/cg_cod.c
@@ -847,9 +847,11 @@ void CG_ToggleFlashlight_f( void ) {
 }
 
 void CG_CodAddFlashlight( void ) {
-	vec3_t start, end, lightPos;
+	vec3_t start, dir, end, lightPos;
+	vec4_t color;
 	trace_t tr;
-	float intensity;
+	float intensity, range, t, falloff;
+	int i;
 
 	if ( !cg.codFlashlightOn ) {
 		return;
@@ -866,24 +868,50 @@ void CG_CodAddFlashlight( void ) {
 
 	intensity = bg_cod.flashlightIntensity;
 	if ( intensity < 1.0f ) {
-		intensity = 350.0f;
+		intensity = 500.0f;
+	}
+	// Beam length scales with intensity (default 500 → ~750 u).
+	range = intensity * 1.5f;
+	if ( range < 512.0f ) {
+		range = 512.0f;
+	}
+	if ( range > 1536.0f ) {
+		range = 1536.0f;
 	}
 
-	// Trace ahead so the beam lights walls (point light at the eye alone is easy to miss).
-	// REF_FORCE_DLIGHT: wolfconfig often has r_dynamiclight 0 — without FORCE the light is dropped.
+	// Origin slightly forward of the eye so the cone clears the near plane / gun mesh.
 	VectorCopy( cg.refdef.vieworg, start );
-	VectorMA( start, 768.0f, cg.refdef.viewaxis[0], end );
+	VectorMA( start, 12.0f, cg.refdef.viewaxis[0], start );
+	VectorCopy( cg.refdef.viewaxis[0], dir );
+
+	color[0] = bg_cod.flashlightR;
+	color[1] = bg_cod.flashlightG;
+	color[2] = bg_cod.flashlightB;
+	color[3] = 0.28f;
+
+	// Proper spotlight cone + core + wall impact (engine CG_Spotlight). No map
+	// searchlight props, no camera flare, no built-in dlight (we force our own).
+	CG_Spotlight( &cg.predictedPlayerEntity, color, start, dir,
+				  16, range, 0, 7.0f,
+				  SL_NOMODEL | SL_NOFLARE | SL_NODLIGHT | SL_NOSTARTCAP | SL_LOCKTRACETORANGE );
+
+	// REF_FORCE_DLIGHT: wolfconfig often has r_dynamiclight 0 — without FORCE lights are dropped.
+	VectorMA( start, range, dir, end );
 	CG_Trace( &tr, start, NULL, NULL, end, cg.snap->ps.clientNum, MASK_SHOT );
-	VectorMA( start, 32.0f + 200.0f * tr.fraction, cg.refdef.viewaxis[0], lightPos );
 
-	trap_R_AddLightToScene( lightPos, intensity * ( 0.55f + 0.45f * tr.fraction ),
-							bg_cod.flashlightR, bg_cod.flashlightG, bg_cod.flashlightB,
-							REF_FORCE_DLIGHT );
-	// Soft fill near the view so close geometry is lit too.
-	VectorMA( start, 24.0f, cg.refdef.viewaxis[0], lightPos );
-	trap_R_AddLightToScene( lightPos, intensity * 0.35f,
+	VectorMA( start, 20.0f, dir, lightPos );
+	trap_R_AddLightToScene( lightPos, intensity * 0.45f,
 							bg_cod.flashlightR, bg_cod.flashlightG, bg_cod.flashlightB,
 							REF_FORCE_DLIGHT );
+
+	for ( i = 1; i <= 4; i++ ) {
+		t = ( (float)i / 4.0f ) * tr.fraction;
+		falloff = 1.0f - t * 0.5f;
+		VectorMA( start, range * t, dir, lightPos );
+		trap_R_AddLightToScene( lightPos, intensity * 0.5f * falloff,
+								bg_cod.flashlightR, bg_cod.flashlightG, bg_cod.flashlightB,
+								REF_FORCE_DLIGHT );
+	}
 }
 
 /*
diff --git a/SP/code/cgame/cg_effects.c b/SP/code/cgame/cg_effects.c
index addbeecf..01e0c223 100644
--- a/SP/code/cgame/cg_effects.c
+++ b/SP/code/cgame/cg_effects.c
@@ -1274,6 +1274,7 @@ CG_Spotlight
 	SL_NOIMPACT			- don't draw the impact mark on hit surfaces
 	SL_LOCKUV			- lock the texture coordinates at the 'true' length of the requested beam.
 	SL_NOCORE			- don't draw the center 'core' beam
+	SL_NOMODEL			- don't draw searchlight base/lamp models (player flashlight)
 
 
 
@@ -1385,8 +1386,8 @@ void CG_Spotlight( centity_t *cent, float *color, vec3_t realstart, vec3_t light
 	// TODO: move much of this to renderer
 
 
-// model at base
-	//if(cgs.media.spotLightLightModel) {
+// model at base (skipped for player flashlight — SL_NOMODEL)
+	if ( !( flags & SL_NOMODEL ) ) {
 		memset( &ent, 0, sizeof( ent ) );
 		ent.frame = 0;
 		ent.oldframe = 0;
@@ -1412,10 +1413,10 @@ void CG_Spotlight( centity_t *cent, float *color, vec3_t realstart, vec3_t light
 
 		// push start out a bit so the beam fits to the front of the base model
 		VectorMA( start, 14, lightDir, start );
-	//}
 
-	if ( cent->currentState.frame == 1 ) {    // dead
-		return;
+		if ( cent->currentState.frame == 1 ) {    // dead
+			return;
+		}
 	}
 
 //// BEAM
diff --git a/SP/code/cgame/cg_local.h b/SP/code/cgame/cg_local.h
index 2f604c12..c6620da4 100644
--- a/SP/code/cgame/cg_local.h
+++ b/SP/code/cgame/cg_local.h
@@ -2220,6 +2220,7 @@ void CG_Spotlight( centity_t *cent, float *color, vec3_t start, vec3_t dir, int
 #define SL_LOCKUV           0x080   // lock the texture coordinates at the 'true' length of the requested beam.
 #define SL_NOCORE           0x100   // don't draw the center 'core' beam
 #define SL_TRACEWORLDONLY   0x200
+#define SL_NOMODEL          0x400   // codmod: skip searchlight base/lamp md3s (player flashlight)
 //----(SA)	done
 
 void CG_RumbleEfx( float pitch, float yaw );
diff --git a/SP/code/game/g_active.c b/SP/code/game/g_active.c
index b2d3dabc..75af15c7 100644
--- a/SP/code/game/g_active.c
+++ b/SP/code/game/g_active.c
@@ -803,9 +803,16 @@ void ClientThink_real( gentity_t *ent ) {
 	}
 
 	if ( client->cameraPortal ) {
-		G_SetOrigin( client->cameraPortal, client->ps.origin );
-		trap_LinkEntity( client->cameraPortal );
-		VectorCopy( client->cameraOrigin, client->cameraPortal->s.origin2 );
+		// codmod: reject dangling pointers from legacy saves (cameraPortal was not F_ENTITY)
+		if ( client->cameraPortal < g_entities
+			 || client->cameraPortal >= g_entities + MAX_GENTITIES
+			 || !client->cameraPortal->inuse ) {
+			client->cameraPortal = NULL;
+		} else {
+			G_SetOrigin( client->cameraPortal, client->ps.origin );
+			trap_LinkEntity( client->cameraPortal );
+			VectorCopy( client->cameraOrigin, client->cameraPortal->s.origin2 );
+		}
 	}
 
 	// mark the time, so the connection sprite can be removed
diff --git a/SP/code/game/g_save.c b/SP/code/game/g_save.c
index 5d29aad1..5a1967df 100644
--- a/SP/code/game/g_save.c
+++ b/SP/code/game/g_save.c
@@ -186,6 +186,12 @@ static ignoreField_t gclientIgnoreFields[] = {
 	//{CFOFS(ps.eventSequence),	sizeof(int)},
 	//{CFOFS(ps.oldEventSequence),sizeof(int)},
 
+	// codmod: cameraPortal / persistantPowerup are raw pointers not in gclientFields.
+	// Old saves store garbage addresses; loading them crashes in ClientThink_real → G_SetOrigin.
+	// Ignore on load (keep the zeroed client value). Cutscene cameras do not survive load.
+	{CFOFS( cameraPortal ),       sizeof( gentity_t * )},
+	{CFOFS( persistantPowerup ),  sizeof( gentity_t * )},
+
 	{0, 0}
 };
 
@@ -695,6 +701,10 @@ void ReadClient( fileHandle_t f, gclient_t *client, int size ) {
 		client->ps.eFlags |= EF_FORCE_END_FRAME;
 	}
 
+	// codmod: belt-and-suspenders — never keep a cutscene camera pointer across load
+	client->cameraPortal = NULL;
+	client->persistantPowerup = NULL;
+
 	// RF, disabled, not required now with screen fading, causes characters to possibly spawn events
 	// before they are known in the cgame
 	// run a client frame to drop exactly to the floor,
-- 
2.56.0

