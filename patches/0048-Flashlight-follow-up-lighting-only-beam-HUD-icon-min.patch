 	{ COD_MI_SECTION, "FLASHLIGHT", NULL, 0, 0, NULL },
 	{ COD_MI_BOOL,  "cod_flashlightEnable",   "cod_flashlightEnable",   1,     1,    NULL },
 	{ COD_MI_FLOAT, "cod_flashlightIntensity","cod_flashlightIntensity",25,    50,   NULL },
+	{ COD_MI_FLOAT, "cod_flashlightMinDist",  "cod_flashlightMinDist",  8,     32,   NULL },
 	{ COD_MI_FLOAT, "cod_flashlightR",        "cod_flashlightR",        0.05f, 0.1f, NULL },
 	{ COD_MI_FLOAT, "cod_flashlightG",        "cod_flashlightG",        0.05f, 0.1f, NULL },
 	{ COD_MI_FLOAT, "cod_flashlightB",        "cod_flashlightB",        0.05f, 0.1f, NULL },
diff --git a/SP/code/cgame/cg_local.h b/SP/code/cgame/cg_local.h
index c6620da4..76eb0325 100644
--- a/SP/code/cgame/cg_local.h
+++ b/SP/code/cgame/cg_local.h
@@ -2259,6 +2259,7 @@ void CG_ToggleFlashlight_f( void );    // codmod: phase 5d flashlight
 void CG_CodResetBinds_f( void );       // codmod: phase 5d full bind reset
 void CG_CodUpdateToggleCrouch( void ); // codmod: phase 5d auto-stand on jump
 void CG_CodAddFlashlight( void );      // codmod: phase 5d view dlight
+void CG_CodDrawFlashlightHudIcon( float weapX, float weapY, float weapW, float weapH ); // codmod: HUD on-indicator
 void CG_QuickKnife_f( void );          // codmod: phase 5.5 CoD-style quick knife
 float CG_CodAdsFrac( void );           // codmod: phase 3.5, raw 0..1, forced to 1 by cod_adsLock
