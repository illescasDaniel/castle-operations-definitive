diff --git a/SP/code/rend2/glsl/dlight_vp.glsl b/SP/code/rend2/glsl/dlight_vp.glsl
index c326bd78..0915a9d4 100644
--- a/SP/code/rend2/glsl/dlight_vp.glsl
+++ b/SP/code/rend2/glsl/dlight_vp.glsl
@@ -3,6 +3,7 @@ attribute vec4 attr_TexCoord0;
 attribute vec3 attr_Normal;
 
 uniform vec4   u_DlightInfo;
+uniform vec4   u_LightSpot; // codmod: xyz dir (local), w = cos(outer); w < -1.5 = point
 
 #if defined(USE_DEFORM_VERTEXES)
 uniform int    u_DeformGen;
@@ -87,6 +88,23 @@ void main()
 	var_Tex1 = dist.xy * u_DlightInfo.a + vec2(0.5);
 	float dlightmod = step(0.0, dot(dist, normal));
 	dlightmod *= clamp(2.0 * (1.0 - abs(dist.z) * u_DlightInfo.a), 0.0, 1.0);
+
+	// codmod: clip classic projective dlights to the spotlight cone
+	if (u_LightSpot.w > -1.5)
+	{
+		vec3 lightToFrag = -dist;
+		float len2 = dot(lightToFrag, lightToFrag);
+		if (len2 > 0.0001)
+		{
+			float cd = dot(normalize(u_LightSpot.xyz), lightToFrag * inversesqrt(len2));
+			float inner = mix(u_LightSpot.w, 1.0, 0.35);
+			dlightmod *= smoothstep(u_LightSpot.w, inner, cd);
+		}
+		else
+		{
+			dlightmod = 0.0;
+		}
+	}
 	
 	var_Color = u_Color * dlightmod;
 }
diff --git a/SP/code/rend2/glsl/lightall_fp.glsl b/SP/code/rend2/glsl/lightall_fp.glsl
index 28b59eb7..7a15cd99 100644
--- a/SP/code/rend2/glsl/lightall_fp.glsl
+++ b/SP/code/rend2/glsl/lightall_fp.glsl
@@ -225,6 +225,21 @@ float CalcLightAttenuation(float point, float normDist)
 	return attenuation;
 }
 
+#if defined(USE_LIGHT_VECTOR)
+// codmod: spotlight cone. lightToFrag is normalized direction from light → fragment.
+// u_LightSpot.w < -1.5 → omnidirectional (disabled).
+uniform vec4 u_LightSpot;
+
+float CalcSpotAttenuation(vec3 lightToFrag)
+{
+	if (u_LightSpot.w < -1.5)
+		return 1.0;
+	float cd = dot(normalize(u_LightSpot.xyz), lightToFrag);
+	float inner = mix(u_LightSpot.w, 1.0, 0.35);
+	return smoothstep(u_LightSpot.w, inner, cd);
+}
+#endif
+
 #if defined(USE_BOX_CUBEMAP_PARALLAX)
 vec4 hitCube(vec3 ray, vec3 pos, vec3 invSize, float lod, samplerCube tex)
 {
@@ -322,6 +337,7 @@ void main()
 
   #if defined(USE_LIGHT_VECTOR)
 	attenuation  = CalcLightAttenuation(float(var_LightDir.w > 0.0), var_LightDir.w / sqrLightDist);
+	attenuation *= CalcSpotAttenuation(-L);
   #else
 	attenuation  = 1.0;
   #endif
