index 3e49c1c5..5ba59c6b 100644
--- a/SP/code/rend2/tr_scene.c
+++ b/SP/code/rend2/tr_scene.c
@@ -366,6 +366,9 @@ void RE_AddLightToScene( const vec3_t org, float intensity, float r, float g, fl
 	dl->color[2] = b;
 	dl->dlshader = NULL;
 	dl->overdraw = 0;
+	VectorClear( dl->dir );
+	VectorClear( dl->transformedDir );
+	dl->spotCosOuter = -2.0f; // omnidirectional
 
 	if ( overdraw == 10 ) { // sorry, hijacking 10 for a quick hack (SA)
 		dl->dlshader = R_GetShaderByHandle( RE_RegisterShader( "negdlightshader" ) );
@@ -377,6 +380,47 @@ void RE_AddLightToScene( const vec3_t org, float intensity, float r, float g, fl
 }
 // done.
 
+/*
+=====================
+RE_AddSpotLightToScene
+
+codmod: directional cone light. coneAngleDeg is the outer half-angle.
+Falls back to a point light if the direction is degenerate.
+=====================
+*/
+void RE_AddSpotLightToScene( const vec3_t org, float intensity, float r, float g, float b,
+							 const vec3_t dir, float coneAngleDeg, int overdraw ) {
+	dlight_t *dl;
+	vec3_t ndir;
+	float cosOuter;
+	int idx;
+
+	if ( !dir || VectorLengthSquared( dir ) < 0.0001f ) {
+		RE_AddLightToScene( org, intensity, r, g, b, overdraw );
+		return;
+	}
+
+	idx = r_numdlights;
+	RE_AddLightToScene( org, intensity, r, g, b, overdraw );
+	if ( r_numdlights == idx ) {
+		return; // light was rejected
+	}
+
+	dl = &backEndData->dlights[r_numdlights - 1];
+	VectorNormalize2( dir, ndir );
+	VectorCopy( ndir, dl->dir );
+	VectorCopy( ndir, dl->transformedDir );
+
+	if ( coneAngleDeg < 1.0f ) {
+		coneAngleDeg = 1.0f;
+	}
+	if ( coneAngleDeg > 89.0f ) {
+		coneAngleDeg = 89.0f;
+	}
+	cosOuter = (float)cos( (double)DEG2RAD( coneAngleDeg ) );
+	dl->spotCosOuter = cosOuter;
+}
+
 
