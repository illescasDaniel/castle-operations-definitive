+		float inner = mix(u_LightSpot.w, 1.0, 0.35);
+		attenuation *= smoothstep(u_LightSpot.w, inner, cd);
+	}
 
 	var_Color.rgb *= u_DirectedLight * (attenuation * NL) + u_AmbientLight;
   #else
