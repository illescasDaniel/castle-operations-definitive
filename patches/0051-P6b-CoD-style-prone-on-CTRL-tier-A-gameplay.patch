+++ b/SP/code/cgame/cg_cod.c
@@ -617,6 +617,12 @@ static const char *CG_CodStateName( void ) {
 	if ( ps->pm_flags & PMF_COD_SLIDING ) {
 		return "SLIDE";
 	}
+	if ( ps->stats[STAT_COD_FLAGS] & COD_SF_PRONE ) {
+		if ( ps->stats[STAT_COD_FLAGS] & COD_SF_PRONE_MOVING ) {
+			return "CRAWL";
