+	Cmd_AddCommand( "+prone", IN_Wbutton7Down );
+	Cmd_AddCommand( "-prone", IN_Wbutton7Up );
 //----(SA) end
 
 	Cmd_AddCommand( "+mlook", IN_MLookDown );
