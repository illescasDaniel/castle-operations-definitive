+		return;
+	}
+	f = ( mag - threshold ) / ( 1.0f - threshold );
+	if ( f > 1.0f ) {
+		f = 1.0f;
+	}
+	*x = ( *x / mag ) * f;
+	*y = ( *y / mag ) * f;
