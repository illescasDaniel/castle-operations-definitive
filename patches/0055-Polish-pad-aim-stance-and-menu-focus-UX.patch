+static void IN_CodApplyRadialDeadzone( float *x, float *y, float threshold )
+{
+	float mag, f;
+
+	mag = (float)sqrt( (double)( ( *x ) * ( *x ) + ( *y ) * ( *y ) ) );
+	if ( mag < 1e-6f ) {
+		*x = 0.0f;
+		*y = 0.0f;
