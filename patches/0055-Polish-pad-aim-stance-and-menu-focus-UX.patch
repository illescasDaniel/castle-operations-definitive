 ================
 CG_ToggleFlashlight_f / CG_CodAddFlashlight
@@ -1930,3 +2084,215 @@ void CG_CodDrawHitMarker( void ) {
 	CG_CodDrawHitMarkerDiag( cx - gap - len, cy + gap + len, cx - gap, cy + gap, th, color );
 	CG_CodDrawHitMarkerDiag( cx + gap + len, cy + gap + len, cx + gap, cy + gap, th, color );
 }
