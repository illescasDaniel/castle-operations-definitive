 =================
 CL_DemoCompleted
@@ -884,6 +970,10 @@ void CL_DemoCompleted( void )
 {
 	char buffer[ MAX_STRING_CHARS ];
 
+	if ( cl_benchDemo && cl_benchDemo->integer && !cl_timedemo->integer ) {
+		CL_ReportBenchDemo();
