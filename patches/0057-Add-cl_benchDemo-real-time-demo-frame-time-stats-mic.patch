index a6528aa0..ac69144a 100644
--- a/SP/code/qcommon/qcommon.h
+++ b/SP/code/qcommon/qcommon.h
@@ -1146,6 +1146,9 @@ void    Sys_Print( const char *msg );
 // any game related timing information should come from event timestamps
 int     Sys_Milliseconds( void );
 
+// Monotonic microsecond clock for frame-time benchmarking (cl_benchDemo)
+long long Sys_Microseconds( void );
+
 qboolean Sys_RandomBytes( byte *string, int len );
 
 // the system console is shown when a dedicated server is running
diff --git a/SP/code/sys/sys_unix.c b/SP/code/sys/sys_unix.c
index e315f56c..cac883da 100644
--- a/SP/code/sys/sys_unix.c
+++ b/SP/code/sys/sys_unix.c
@@ -171,6 +171,14 @@ unsigned long sys_timeBase = 0;
      0x7fffffff ms - ~24 days
    although timeval:tv_usec is an int, I'm not sure wether it is actually used as an unsigned int
      (which would affect the wrap period) */
+long long Sys_Microseconds( void )
+{
+	struct timespec ts;
+
+	clock_gettime( CLOCK_MONOTONIC, &ts );
+	return (long long)ts.tv_sec * 1000000LL + ts.tv_nsec / 1000;
+}
+
 int curtime;
 int Sys_Milliseconds (void)
 {
diff --git a/SP/code/sys/sys_win32.c b/SP/code/sys/sys_win32.c
index 582d470c..3624f0c7 100644
--- a/SP/code/sys/sys_win32.c
+++ b/SP/code/sys/sys_win32.c
@@ -235,6 +235,18 @@ char *Sys_GogPath( void )
 Sys_Milliseconds
 ================
 */
+long long Sys_Microseconds( void )
+{
+	static LARGE_INTEGER freq;
+	LARGE_INTEGER now;
+
+	if ( !freq.QuadPart ) {
+		QueryPerformanceFrequency( &freq );
+	}
+	QueryPerformanceCounter( &now );
+	return now.QuadPart * 1000000LL / freq.QuadPart;
+}
+
 int sys_timeBase;
 int Sys_Milliseconds (void)
 {
