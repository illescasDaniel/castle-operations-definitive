+/*
+================
+Sys_WaitUntil
+
+Hybrid sleep + spin until the Sys_Microseconds deadline. High-resolution
+waitable timer when available (Win10 1803+), else Sleep. Returns overshoot (us).
+================
+*/
+#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
+#endif
+long long Sys_WaitUntil( long long deadlineUs, int spinUs )
+{
+	static HANDLE timer;
+	static qboolean tried;
+	static int autoSpin = 500, worstRing[32], ringPos;
+	long long now, wake;
+	int margin, i, worst;
+
+	if ( !tried ) {
+		timer = CreateWaitableTimerExW( NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS );
+		tried = qtrue;
+	}
+
+	margin = ( spinUs < 0 ) ? autoSpin : spinUs;
+	now = Sys_Microseconds();
+	wake = deadlineUs - margin;
+	if ( wake > now ) {
+		if ( timer ) {
+			LARGE_INTEGER due;
+			due.QuadPart = -( ( wake - now ) * 10 );    // relative, 100 ns units
+			SetWaitableTimer( timer, &due, 0, NULL, NULL, FALSE );
+			WaitForSingleObject( timer, INFINITE );
+		} else if ( wake - now >= 2000 ) {
+			Sleep( (DWORD)( ( wake - now ) / 1000 - 1 ) );
+		}
+		if ( spinUs < 0 ) {
+			int over = (int)( Sys_Microseconds() - wake );
+			worstRing[ringPos++ & 31] = over < 0 ? 0 : over;
+			for ( worst = 0, i = 0; i < 32; i++ ) {
+				if ( worstRing[i] > worst ) {
+					worst = worstRing[i];
+				}
+			}
+			autoSpin = worst + 100;
+			if ( autoSpin > 2000 ) {
+				autoSpin = 2000;
+			}
+		}
+	}
+	while ( ( now = Sys_Microseconds() ) < deadlineUs ) {
+		YieldProcessor();
+	}
+	return now - deadlineUs;
+}
