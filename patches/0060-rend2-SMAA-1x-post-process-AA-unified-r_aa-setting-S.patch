diff --git a/SP/code/rend2/glsl/smaa_blend_fp.glsl b/SP/code/rend2/glsl/smaa_blend_fp.glsl
new file mode 100644
index 00000000..1184ee73
--- /dev/null
+++ b/SP/code/rend2/glsl/smaa_blend_fp.glsl
@@ -0,0 +1,11 @@
+// SMAA 1x pass 3: neighborhood blending (fragment). Uses the SMAA library in smaa_lib.glsl.
+uniform sampler2D u_TextureMap;   // scene color
+uniform sampler2D u_LevelsMap;    // blend weights
+
+varying vec2   var_TexCoords;
+varying vec4   var_Offset;
+
+void main()
+{
+	gl_FragColor = SMAANeighborhoodBlendingPS(var_TexCoords, var_Offset, u_TextureMap, u_LevelsMap);
+}
diff --git a/SP/code/rend2/glsl/smaa_blend_vp.glsl b/SP/code/rend2/glsl/smaa_blend_vp.glsl
new file mode 100644
index 00000000..5a8900fc
--- /dev/null
+++ b/SP/code/rend2/glsl/smaa_blend_vp.glsl
@@ -0,0 +1,16 @@
+// SMAA 1x pass 3: neighborhood blending (vertex). Uses the SMAA library in smaa_lib.glsl.
+attribute vec3 attr_Position;
+attribute vec4 attr_TexCoord0;
+
+uniform mat4   u_ModelViewProjectionMatrix;
+
+varying vec2   var_TexCoords;
+varying vec4   var_Offset;
+
+void main()
+{
+	gl_Position = u_ModelViewProjectionMatrix * vec4(attr_Position, 1.0);
+	var_TexCoords = attr_TexCoord0.st;
+
+	SMAANeighborhoodBlendingVS(var_TexCoords, var_Offset);
+}
diff --git a/SP/code/rend2/glsl/smaa_edge_fp.glsl b/SP/code/rend2/glsl/smaa_edge_fp.glsl
new file mode 100644
index 00000000..3a6f70d0
--- /dev/null
+++ b/SP/code/rend2/glsl/smaa_edge_fp.glsl
@@ -0,0 +1,17 @@
+// SMAA 1x pass 1: luma edge detection (fragment). Uses the SMAA library in smaa_lib.glsl.
+uniform sampler2D u_TextureMap;
+
+varying vec2   var_TexCoords;
+varying vec4   var_Offset0;
+varying vec4   var_Offset1;
+varying vec4   var_Offset2;
+
+void main()
+{
+	vec4 offset[3];
+	offset[0] = var_Offset0;
+	offset[1] = var_Offset1;
+	offset[2] = var_Offset2;
+
+	gl_FragColor = vec4(SMAALumaEdgeDetectionPS(var_TexCoords, offset, u_TextureMap), 0.0, 1.0);
+}
diff --git a/SP/code/rend2/glsl/smaa_edge_vp.glsl b/SP/code/rend2/glsl/smaa_edge_vp.glsl
new file mode 100644
index 00000000..2dd4f4e0
--- /dev/null
+++ b/SP/code/rend2/glsl/smaa_edge_vp.glsl
@@ -0,0 +1,23 @@
+// SMAA 1x pass 1: luma edge detection (vertex). Uses the SMAA library in smaa_lib.glsl.
+attribute vec3 attr_Position;
+attribute vec4 attr_TexCoord0;
+
+uniform mat4   u_ModelViewProjectionMatrix;
+
+varying vec2   var_TexCoords;
+varying vec4   var_Offset0;
+varying vec4   var_Offset1;
+varying vec4   var_Offset2;
+
+void main()
+{
+	vec4 offset[3];
+
+	gl_Position = u_ModelViewProjectionMatrix * vec4(attr_Position, 1.0);
+	var_TexCoords = attr_TexCoord0.st;
+
+	SMAAEdgeDetectionVS(var_TexCoords, offset);
+	var_Offset0 = offset[0];
+	var_Offset1 = offset[1];
+	var_Offset2 = offset[2];
+}
diff --git a/SP/code/rend2/glsl/smaa_lib.glsl b/SP/code/rend2/glsl/smaa_lib.glsl
